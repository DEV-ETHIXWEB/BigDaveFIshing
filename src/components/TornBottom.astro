---
import { TEAR_W, TEAR_H, tornEdgeLine } from '../lib/torn-edge';

/**
 * The frayed fibres drawn along a torn bottom edge. Pair with the `.torn-bottom`
 * class on the section itself (plus `--tear-mask`, from `tornMaskUrl()`), which is
 * what actually cuts the section off along the rip so the section behind shows
 * through with no band of colour in between.
 */
const line = tornEdgeLine();
---

<svg
  viewBox={`0 0 ${TEAR_W} ${TEAR_H}`}
  preserveAspectRatio="none"
  class="pointer-events-none absolute inset-x-0 bottom-0 block h-9 w-full md:h-14"
  aria-hidden="true"
>
  <path d={line} fill="none" stroke="#fffaf0" stroke-width="5" opacity="0.9"></path>
  <path d={line} fill="none" stroke="#fffaf0" stroke-width="10" opacity="0.28"></path>
</svg>
