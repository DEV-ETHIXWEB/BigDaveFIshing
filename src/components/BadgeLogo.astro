---
// Placeholder brand mark — no real logo file was supplied, only background
// illustrations. Swap for the real Big Dave's Fishing Adventures logo when available.
// Used by the desktop (xl+) header only; the mobile design uses the raster badge in
// public/art instead.
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<svg
  viewBox="0 0 200 200"
  class:list={[className]}
  role="img"
  aria-label="Big Dave's Fishing Adventures — placeholder logo mark"
>
  <path id="badge-ring-top" d="M 22,104 A 78,78 0 1,1 178,104" fill="none"></path>
  <path id="badge-ring-bottom" d="M 178,100 A 78,78 0 1,1 22,100" fill="none"></path>

  <circle cx="100" cy="100" r="94" fill="none" stroke="currentColor" stroke-width="3"></circle>
  <circle cx="100" cy="100" r="66" fill="none" stroke="currentColor" stroke-width="1.5"></circle>

  <text font-family="Rye, serif" font-size="12" letter-spacing="2" fill="currentColor">
    <textPath href="#badge-ring-top" startOffset="50%" text-anchor="middle">
      BIG DAVE'S FISHING ADVENTURES
    </textPath>
  </text>
  <text font-family="Rye, serif" font-size="10" letter-spacing="2" fill="currentColor">
    <textPath href="#badge-ring-bottom" startOffset="50%" text-anchor="middle">
      OREGON COAST • GUIDED TRIPS
    </textPath>
  </text>

  <g transform="translate(100,108)">
    <path
      d="M0,-38 L10,-16 L4,-16 L14,4 L6,4 L18,24 L-18,24 L-6,4 L-14,4 L-4,-16 L-10,-16 Z"
      fill="currentColor"></path>
    <rect x="-3" y="24" width="6" height="10" fill="currentColor"></rect>
    <path
      d="M-30,38 Q-15,32 0,38 Q15,44 30,38"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"></path>
  </g>
</svg>
