---
import { Image } from 'astro:assets';
import guidedTripA from '../../assets/images/guided-fishing-trip-1.png';
import guidedTripB from '../../assets/images/guided-fishing-trip-2.png';
import lodgeBackground from '../../assets/images/lodge-background.png';
import Ornament from '../ui/Ornament.astro';
---

<!-- Screen 2: image, eyebrow, big serif heading, body, outline button - all on black. -->
<section id="trips" class="bg-ink text-cream relative">
  <div class="relative">
    <Image
      src={guidedTripA}
      alt="Illustrated angler casting a fly rod from the riverbank toward a drift boat"
      class="block h-[38vh] max-h-[360px] min-h-[240px] w-full object-cover object-top md:h-[54vh] md:max-h-none"
      widths={[768, 1200, 1536]}
      sizes="100vw"
    />
    <!-- Two near-identical frames crossfaded on an infinite loop, so the illustration
         gently "breathes" rather than sitting static. -->
    <Image
      src={guidedTripB}
      alt=""
      aria-hidden="true"
      class="trip-crossfade absolute inset-0 block h-full w-full object-cover object-top"
      widths={[768, 1200, 1536]}
      sizes="100vw"
    />
  </div>

  <div class="px-6 py-12 text-center md:px-8 md:py-16">
    <p class="eyebrow text-cream/60">Guided Experiences</p>
    <h2 class="mt-4 text-[1.6rem] md:text-4xl">Fish. Explore.<br />Unwind.</h2>
    <p class="text-cream/70 mx-auto mt-5 max-w-xs text-sm md:max-w-md md:text-base">
      Half-day, full-day, and custom trips for steelhead and salmon. Boat, tackle, and know-how
      included.
    </p>
    <a href="/rates-packages" class="btn btn-outline-light mt-7">View All Trips</a>
  </div>
</section>

<!-- Screen 3: light section - eyebrow, heading, ornament, artwork, body, solid button. -->
<section class="bg-cream text-ink">
  <div class="px-6 pt-14 text-center md:px-8 md:pt-20">
    <p class="eyebrow text-ink/70">The Lodge</p>
    <h2 class="mt-4 text-[1.6rem] md:text-4xl">Wild Places<br />Await</h2>
    <Ornament class="mx-auto mt-5" />
  </div>

  <Image
    src={lodgeBackground}
    alt="Illustrated log cabin lodge on the bank of the Wilson River, mountains behind"
    class="mt-8 block w-full"
    widths={[768, 1200, 1536]}
    sizes="100vw"
  />

  <div class="px-6 pt-8 pb-14 text-center md:px-8 md:pb-20">
    <p class="text-ink/70 mx-auto max-w-xs text-sm md:max-w-md md:text-base">
      The Wilson River Lodge is more than a bed — bunk close to the water, fish right from the
      lodge, and make a weekend of it.
    </p>
    <a href="/wilson-river-lodge" class="btn btn-solid-dark mt-7">See The Lodge</a>
  </div>
</section>

<style>
  .trip-crossfade {
    opacity: 0;
    animation: trip-crossfade 4s ease-in-out infinite;
    will-change: opacity;
  }

  /* Continuously alternates between the two poses: 2s to fade across, 2s to fade
     back, with no hold in between, so the rod never sits still. */
  @keyframes trip-crossfade {
    0% {
      opacity: 0;
    }
    50% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .trip-crossfade {
      animation: none;
      opacity: 0;
    }
  }
</style>
