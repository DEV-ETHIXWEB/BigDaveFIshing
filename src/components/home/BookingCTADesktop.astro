---
import { Phone, MapPin, Compass, Fish } from 'lucide-react';
import BookingFormDesktop from './BookingFormDesktop';
import { business } from '../../lib/business';

// Trust strip along the foot of the left column.
const trust = [
  { icon: MapPin, title: 'Based in Oregon', sub: 'Tillamook County' },
  { icon: Compass, title: 'Guide Service', sub: 'Rivers & Bays' },
  { icon: Fish, title: 'Local. Trusted.', sub: 'Personalised Trips' },
];
---

<!-- id is `book-desktop` rather than `book`: both the mobile and the desktop stacks are
     in the DOM at all times (one is display:none), so the anchor has to be unique or
     the jump lands on a hidden element. Desktop links point here. -->
<section id="book-desktop" class="bg-ink text-cream relative overflow-hidden py-20 md:py-28">
  <div class="mx-auto grid max-w-7xl items-start gap-14 px-4 md:px-8 lg:grid-cols-2 lg:gap-20">
    <div>
      <div class="flex items-center gap-4">
        <p class="eyebrow text-copper whitespace-nowrap">Ready To Go</p>
        <span class="via-copper/50 h-px flex-1 bg-gradient-to-r from-transparent to-transparent"
        ></span>
      </div>

      <h2 class="mt-5 text-4xl md:text-5xl">Book Your Trip</h2>

      <p class="text-cream/70 mt-6 max-w-md leading-relaxed">
        Call or send an enquiry. Dave books trips out weeks in advance during peak season, so the
        earlier you reach out, the better your pick of dates.
      </p>

      <a
        href={business.phoneHref}
        class="group mt-8 flex items-center gap-4"
        aria-label={`Call ${business.phone}`}
      >
        <span
          class="border-copper/50 text-copper group-hover:bg-copper/10 flex h-12 w-12 items-center justify-center rounded-full border transition-colors"
        >
          <Phone size={19} strokeWidth={1.5} aria-hidden="true" />
        </span>
        <span class="font-display text-2xl tracking-[0.04em] md:text-3xl">{business.phone}</span>
      </a>

      <div class="border-cream/15 mt-12 border-l-2 pl-5">
        <p class="font-display text-copper text-lg tracking-[0.06em]">Prefer To Call?</p>
        <p class="text-cream/65 mt-2 max-w-xs text-sm leading-relaxed">
          Dave is often on the water. Leave a message and he'll get back to you as soon as he's off
          the river.
        </p>
      </div>

      <ul class="border-cream/10 mt-12 grid grid-cols-3 gap-4 border-t pt-6">
        {
          trust.map((item) => (
            <li class="flex items-start gap-2.5">
              <item.icon
                size={18}
                strokeWidth={1.5}
                aria-hidden="true"
                className="text-copper mt-0.5 shrink-0"
              />
              <div>
                <p class="text-sm leading-tight">{item.title}</p>
                <p class="text-cream/50 mt-0.5 text-xs">{item.sub}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>

    <BookingFormDesktop client:visible />
  </div>
</section>
