---
import Ornament from '../ui/Ornament.astro';

// Not one of the mockup's screens, but the brief requires a price up front. Styled with
// the same eyebrow / serif heading / ornament / outline button pattern as the rest.
// SAMPLE pricing - replace with real current rates before launch.
const rates = [
  { label: 'Guided Day Trip', price: '$275', unit: 'per angler' },
  { label: 'Wilson River Lodge', price: '$650', unit: 'per person, 2-night' },
];
---

<section class="bg-ink text-cream">
  <div class="mx-auto max-w-md px-6 pt-14 pb-14 text-center md:px-8 md:pt-20 md:pb-20">
    <p class="eyebrow text-cream/60">Rates</p>
    <h2 class="mt-4 text-[1.6rem] md:text-4xl">No Hunting<br />For A Number</h2>
    <Ornament tone="light" class="mx-auto mt-5" />

    <ul class="mt-9 space-y-3">
      {
        rates.map((rate) => (
          <li class="border-cream/15 bg-cream/[0.06] flex items-baseline justify-between rounded border px-5 py-4 text-left">
            <span class="eyebrow text-cream/60">{rate.label}</span>
            <span class="text-right">
              <span class="font-display text-xl tracking-[0.04em]">{rate.price}</span>
              <span class="text-cream/55 ml-1 text-[0.6875rem]">{rate.unit}</span>
            </span>
          </li>
        ))
      }
    </ul>

    <a href="/rates-packages" class="btn btn-outline-light mt-8">Full Rates &amp; Packages</a>
  </div>
</section>
