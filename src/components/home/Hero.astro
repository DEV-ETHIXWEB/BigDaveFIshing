---
import { business } from '../../lib/business';
import Ornament from '../ui/Ornament.astro';

// Screen 1: full-bleed artwork under a transparent header, then the wordmark block on
// black, then the promise strip with the badge on the right.
const promise = ['Small groups.', 'Wild rivers.', 'Fish you remember.'];
---

<section class="bg-ink text-cream relative">
  <img
    src="/art/hero-background-1536.webp"
    srcset="
      /art/hero-background-768.webp   768w,
      /art/hero-background-1200.webp 1200w,
      /art/hero-background-1536.webp 1536w
    "
    sizes="100vw"
    width="1536"
    height="1024"
    alt="Illustrated view of a quiet Oregon coastal river winding through pine forest"
    class="block h-[46vh] max-h-[420px] min-h-[260px] w-full object-cover object-top md:h-[62vh] md:max-h-none"
    loading="eager"
    fetchpriority="high"
  />

  <div class="px-6 pt-10 pb-8 text-center md:px-8 md:pt-14">
    <h1 class="text-[1.75rem] md:text-5xl">Guided Steelhead<br />&amp; Salmon Trips</h1>
    <Ornament tone="light" class="mx-auto mt-5" />
    <p class="text-cream/70 mx-auto mt-5 max-w-xs text-sm md:max-w-md md:text-base">
      Your adventure, my waters. Day trips and lodge stays on Oregon's coastal rivers.
    </p>
    <a href="#trips" class="btn btn-outline-light mt-7">Explore Trips</a>
  </div>

  <div class="border-cream/15 mx-6 flex items-center justify-between gap-6 border-t py-7 md:mx-8">
    <div>
      <p class="eyebrow text-cream/60">Our Promise</p>
      <ul class="mt-3 space-y-1 text-sm">
        {promise.map((line) => <li>{line}</li>)}
      </ul>
    </div>
    <!-- Cream linework: this strip sits on the dark band under the artwork. -->
    <img
      src="/art/logo-badge-cream-320.webp"
      srcset="/art/logo-badge-cream-320.webp 320w, /art/logo-badge-cream-640.webp 640w"
      sizes="112px"
      width="640"
      height="640"
      alt=""
      class="h-28 w-28 shrink-0"
    />
  </div>

  <p class="pb-8 text-center">
    <a
      href={business.phoneHref}
      class="font-body text-cream/70 hover:text-cream text-sm tracking-wide"
    >
      {business.phone}
    </a>
  </p>
</section>
