---
import { Image } from 'astro:assets';
import { business } from '../../lib/business';
import { photos } from '../../lib/photos';

// The live site's hero is a full-bleed slider of catch photos with one line of script
// type and a Book Now button over it. That is kept exactly. What is added: a scrim so
// the type actually passes contrast over a bright sky, a slow scale drift so a still
// reads as footage, and a crossfade instead of a hard cut.
const slides = [photos.threeAnglers, photos.boatCatch, photos.bayChinookPair];
---

<!-- Height is viewport-based on phones, but at xl+ it is driven by aspect ratio instead.
     The photos are 4:3, and a vh-tall hero on a wide screen makes a box far wider than
     that, so object-cover eats the top and bottom of every one. Pinning the desktop hero
     to 3:2 keeps the mismatch to about a tenth rather than a sixth, whatever the window
     height. max-h stops it running past the fold on short laptops. -->
<section
  class="relative isolate h-[70vh] min-h-[28rem] w-full overflow-hidden sm:h-[78vh] xl:h-auto xl:max-h-[88vh] xl:aspect-[7/5]"
>
  <div data-hero-slides class="absolute inset-0">
    {
      slides.map((slide, i) => (
        <div
          data-hero-slide
          class:list={[
            'absolute inset-0 transition-opacity duration-1000 ease-out',
            i === 0 ? 'opacity-100' : 'opacity-0',
          ]}
          aria-hidden={i === 0 ? undefined : 'true'}
        >
          {/* Two things pin the top edge, because that is where the faces are and
              anything trimmed there is the shot ruined.

              object-[50%_12%] sends almost all of object-cover's trim to the bottom,
              which in these photos is boat, waders and water, and is also where the
              scrim and the headline sit, so it is covered anyway.

              origin-top makes the drift scale grow downward instead of outward from the
              centre. Centre-origin was quietly eating a further ~2% off the top at the
              peak of every cycle, on top of whatever object-cover had already taken. */}
          <Image
            src={slide.src}
            alt={i === 0 ? slide.alt : ''}
            widths={[900, 1400, 1900]}
            sizes="100vw"
            class="h-full w-full origin-top object-cover object-[50%_12%] motion-safe:[animation:hero-drift_18s_ease-out_infinite_alternate]"
            loading={i === 0 ? 'eager' : 'lazy'}
            fetchpriority={i === 0 ? 'high' : undefined}
          />
        </div>
      ))
    }
  </div>

  <div class="photo-scrim absolute inset-0" aria-hidden="true"></div>

  <div class="absolute inset-x-0 bottom-0 px-6 pb-16 sm:pb-24 lg:px-14">
    <!-- The lockup is boxed in a hairline rule that breaks for the eyebrow. It gives
         the type somewhere to sit on a busy photograph without resorting to a panel,
         and it is the one piece of structure the live hero has none of. -->
    <div class="relative mx-auto max-w-2xl text-center">
      <p class="eyebrow mb-5 text-white/85">Tillamook &middot; Oregon Coast</p>

      <div class="border-t border-white/30" aria-hidden="true"></div>

      <h1
        data-reveal-text
        class="mt-6 text-[2.1rem] leading-[1.12] text-white drop-shadow-[0_2px_14px_rgba(0,0,0,0.6)] sm:text-[3rem] lg:text-[3.6rem]"
      >
        Book Your Adventure Today!
      </h1>

      <p class="mx-auto mt-5 max-w-lg text-[0.95rem] text-white/85 sm:text-lg">
        Guided Salmon &amp; Steelhead trips on Oregon&rsquo;s coastal rivers &mdash; Tillamook Bay,
        the Wilson, Kilchis and Trask.
      </p>

      <div class="mt-8 flex flex-wrap items-center justify-center gap-3 sm:gap-4">
        <a href="/contact" class="btn btn-solid-light">Book Now</a>
        <a href={business.phoneHref} class="btn btn-outline-light">{business.phone}</a>
      </div>
    </div>
  </div>

  <!-- Dots double as the only slider control. Arrows were dropped: at phone widths they
       sat on top of the photo's subject, and a three-slide loop does not need them. -->
  <div class="absolute inset-x-0 bottom-4 flex justify-center gap-2.5 sm:bottom-6">
    {
      slides.map((_, i) => (
        <button
          type="button"
          data-hero-dot
          aria-label={`Show slide ${i + 1} of ${slides.length}`}
          aria-current={i === 0 ? 'true' : 'false'}
          class:list={[
            'h-2 w-2 rounded-full transition-all duration-300',
            i === 0 ? 'w-6 bg-white' : 'bg-white/50 hover:bg-white/80',
          ]}
        />
      ))
    }
  </div>
</section>

<script>
  const root = document.querySelector('[data-hero-slides]');
  const slides = Array.from(document.querySelectorAll<HTMLElement>('[data-hero-slide]'));
  const dots = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-hero-dot]'));
  if (root && slides.length > 1) {
    let current = 0;
    let timer: number | undefined;

    const show = (next: number) => {
      slides[current].classList.replace('opacity-100', 'opacity-0');
      slides[current].setAttribute('aria-hidden', 'true');
      dots[current]?.classList.remove('w-6', 'bg-white');
      dots[current]?.classList.add('bg-white/50', 'hover:bg-white/80');
      dots[current]?.setAttribute('aria-current', 'false');

      current = next;

      slides[current].classList.replace('opacity-0', 'opacity-100');
      slides[current].removeAttribute('aria-hidden');
      dots[current]?.classList.add('w-6', 'bg-white');
      dots[current]?.classList.remove('bg-white/50', 'hover:bg-white/80');
      dots[current]?.setAttribute('aria-current', 'true');
    };

    const start = () => {
      stop();
      // Only auto-advance for people who have not asked the OS for less motion.
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      timer = window.setInterval(() => show((current + 1) % slides.length), 6000);
    };
    const stop = () => {
      if (timer) window.clearInterval(timer);
      timer = undefined;
    };

    dots.forEach((dot, i) =>
      dot.addEventListener('click', () => {
        show(i);
        start();
      }),
    );

    // Cheap wins: don't burn frames animating a hero nobody is looking at, and give
    // people a chance to read the caption when they hover it.
    root.addEventListener('mouseenter', stop);
    root.addEventListener('mouseleave', start);
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));

    start();
  }
</script>
