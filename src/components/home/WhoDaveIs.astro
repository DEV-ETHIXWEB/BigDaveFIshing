---
import { Image } from 'astro:assets';
import galleryBackground from '../../assets/images/gallery-background.png';
import Ornament from '../ui/Ornament.astro';

// Screen 7: light section - eyebrow, heading, ornament, the brand medallion, centred
// copy, solid button, then full-bleed artwork below.
---

<section class="bg-cream text-ink">
  <div class="px-6 pt-14 text-center md:px-8 md:pt-20">
    <p class="eyebrow text-ink/70">About Big Dave</p>
    <h2 class="mt-4 text-[1.6rem] md:text-4xl">Rooted In<br />Oregon</h2>
    <Ornament class="mx-auto mt-5" />

    <img
      src="/art/logo-badge-ink-320.webp"
      srcset="/art/logo-badge-ink-320.webp 320w, /art/logo-badge-ink-640.webp 640w"
      sizes="(min-width: 768px) 240px, 190px"
      width="640"
      height="640"
      alt="Etched medallion portrait of Big Dave in a fur trapper hat and sunglasses"
      class="mx-auto mt-8 h-48 w-48 md:h-60 md:w-60"
    />

    <p class="text-ink/70 mx-auto mt-7 max-w-xs text-sm leading-relaxed md:max-w-md md:text-base">
      Two decades guiding the Wilson, Trask, and Nestucca — the only water he's ever fished. Most
      bookings are repeat clients who now bring their sons.
    </p>

    <a href="/fishing-information" class="btn btn-solid-dark mt-7">Our Story</a>
  </div>

  <Image
    src={galleryBackground}
    alt="Illustrated shoreline of pines along a calm coastal river"
    class="mt-12 block w-full"
    widths={[768, 1200, 1536]}
    sizes="100vw"
  />
</section>
