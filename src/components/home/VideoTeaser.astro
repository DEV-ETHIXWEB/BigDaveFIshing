---
import { Image } from 'astro:assets';
import { Play } from 'lucide-react';
import SectionHeading from './SectionHeading.astro';

import { videos as allVideos } from '../../lib/videos';

// A teaser for /videos, not a player — every card links through to the gallery.
//
// Titles come from lib/videos.ts, which holds them verbatim from the live site's slider.
// They used to be hand-written here and three of the four were guesses read off image
// filenames; sharing one manifest means the teaser and the gallery cannot disagree.
const videos = allVideos.slice(0, 4);
---

<section class="bg-cream py-16 lg:py-20">
  <SectionHeading
    eyebrow="Watch"
    title="Video Gallery"
    intro="Days on the water with Big Dave, plus the episodes filmed with Angler West TV."
  />

  <div
    class="mx-auto mt-10 grid max-w-6xl gap-4 px-4 sm:grid-cols-2 sm:px-6 lg:grid-cols-4 lg:px-10"
    data-reveal
  >
    {
      videos.map((video) => (
        <a href="/videos" class="group video-card block">
          <div class="video-card__frame relative">
            <Image
              src={video.thumb}
              alt=""
              widths={[400, 800]}
              sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw"
              class="video-card__media aspect-video w-full object-cover"
              loading="lazy"
            />
            <span
              class="absolute inset-0 bg-black/25 transition-colors group-hover:bg-black/10"
              aria-hidden="true"
            />
            <span class="absolute inset-0 flex items-center justify-center" aria-hidden="true">
              <span class="flex h-12 w-12 items-center justify-center rounded-full bg-white/90 text-ink shadow-lg transition-transform duration-300 group-hover:scale-110">
                <Play size={18} fill="currentColor" strokeWidth={0} className="ml-0.5" />
              </span>
            </span>
          </div>

          <h3 class="text-ink group-hover:text-graphite mt-3 text-[1.05rem] leading-snug transition-colors">
            {video.title}
          </h3>
          <p class="text-ink/60 mt-1 text-sm">{video.detail}</p>
        </a>
      ))
    }
  </div>

  <div class="mt-10 text-center">
    <a href="/videos" class="btn btn-outline-dark">See All Videos</a>
  </div>
</section>
