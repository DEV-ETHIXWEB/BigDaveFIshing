---
import { getImage } from 'astro:assets';
import { accordionPhotos } from '../../lib/photos';
import AccordionGallery from '../ui/AccordionGallery.tsx';
import SectionHeading from './SectionHeading.astro';

// The photographs are the thing the client actually likes about their site, so this is
// the one section where the page stops being a layout and becomes an interaction.
//
// The accordion desaturates every closed panel and returns the open one to full colour,
// which is this design's whole colour rule made literal: grey chrome, and colour only
// where you are looking.
//
// The island takes plain URL strings, so each photo is run through getImage here at
// build time rather than the React bundle importing source files - the browser still
// gets optimised WebP, and no image handling ships to the client.
const panels = await Promise.all(
  accordionPhotos.map(async (photo) => {
    // Width only - passing a height too would force every photo to one aspect ratio,
    // and these are not all 4:3 (the halibut is 1200x870). Let height follow the source.
    const optimised = await getImage({ src: photo.src, width: 1000, format: 'webp' });
    return { image: optimised.src, alt: photo.alt, label: photo.label };
  }),
);
---

<section id="gallery" class="bg-ink py-16 lg:py-20">
  <SectionHeading
    eyebrow="From the boat"
    title="Recent Catches"
    intro="Real fish, real trips, real clients — no stock photography anywhere on this page."
    tone="light"
  />

  <div class="mx-auto mt-10 max-w-6xl px-4 sm:px-6 lg:px-10" data-reveal>
    <!-- client:visible: this sits well below the fold, so GSAP and the island's JS are
         not fetched until someone actually scrolls to it. -->
    <AccordionGallery
      client:visible
      items={panels}
      defaultIndex={0}
      height={460}
      gap={8}
      radius={2}
      accentColor="#ffffff"
      overlayColor="#111111"
      textColor="#ffffff"
      grayscale={true}
      trigger="hover"
    />

    <p class="text-cream/50 mt-5 text-center text-sm">
      Hover or tap a photo to open it — arrow keys move between them.
    </p>
  </div>
</section>
