---
import PlaceholderPhoto from '../PlaceholderPhoto.astro';
import Ornament from '../ui/Ornament.astro';

// Screen 6: staggered two-column mosaic. The columns are offset so the tiles
// interlock rather than lining up in rows.
const left = [
  { label: 'river run at first light', ratio: 'aspect-[3/4]' },
  { label: 'client with a steelhead', ratio: 'aspect-square' },
];
const right = [
  { label: 'chrome steelhead in the net', ratio: 'aspect-square' },
  { label: 'wading the far bank', ratio: 'aspect-[3/4]' },
];
---

<section class="bg-cream text-ink">
  <div class="px-6 pt-14 text-center md:px-8 md:pt-20">
    <p class="eyebrow text-ink/70">Gallery</p>
    <h2 class="mt-4 text-[1.6rem] md:text-4xl">Moments That<br />Matter</h2>
    <Ornament class="mx-auto mt-5" />
  </div>

  <div class="mx-auto mt-9 grid max-w-md grid-cols-2 gap-3 px-6 md:px-8">
    <div class="space-y-3">
      {
        left.map((photo) => (
          <PlaceholderPhoto label={photo.label} class:list={['w-full rounded-sm', photo.ratio]} />
        ))
      }
    </div>
    <div class="space-y-3 pt-8">
      {
        right.map((photo) => (
          <PlaceholderPhoto label={photo.label} class:list={['w-full rounded-sm', photo.ratio]} />
        ))
      }
    </div>
  </div>

  <div class="px-6 pt-10 pb-14 text-center md:px-8 md:pb-20">
    <a href="/video-gallery" class="btn btn-outline-dark">View Full Gallery</a>
  </div>
</section>
