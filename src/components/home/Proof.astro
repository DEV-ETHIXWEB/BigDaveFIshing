---
import { Image } from 'astro:assets';
import { UserRound, Users, Package } from 'lucide-react';
import firstTimeOut from '../../assets/images/first-time-out-background.png';
import TornEdge from '../TornEdge.astro';

// Screen 5: three feature rows on black, full-bleed artwork, torn edge into a light
// testimonial block with carousel dots.
const features = [
  {
    icon: UserRound,
    title: 'Local Expert',
    copy: 'Two decades on the Wilson, Trask, and Nestucca — the only water Dave has ever fished.',
  },
  {
    icon: Users,
    title: 'Small Groups',
    copy: 'One boat, one guide. Personal trips, never a crowd on the water.',
  },
  {
    icon: Package,
    title: 'Quality Gear',
    copy: 'Rods, tackle, and terminal gear provided so you can focus on the fishing.',
  },
];

// SAMPLE testimonials - replace with real client quotes before launch.
const testimonials = [
  {
    quote: "Put us on fish inside the first hour. Best guided trip we've booked on the coast.",
    name: 'Mike T.',
  },
  { quote: 'My dad and I have gone out with Dave three years running now.', name: 'Chris R.' },
  { quote: 'Boat, gear, patience with beginners — all dialed in.', name: 'Ron K.' },
];
---

<section class="bg-ink text-cream relative">
  <div class="px-6 pt-14 md:px-8 md:pt-20">
    <p class="eyebrow text-cream/60 text-center">Why Fish With Dave</p>

    <ul class="mx-auto mt-9 max-w-md space-y-7">
      {
        features.map((f) => (
          <li class="flex gap-4">
            <span class="border-cream/25 mt-0.5 flex h-10 w-10 shrink-0 items-center justify-center rounded-full border">
              <f.icon size={18} strokeWidth={1.25} aria-hidden="true" />
            </span>
            <div>
              <h3 class="text-[0.8125rem] tracking-[0.16em]">{f.title}</h3>
              <p class="text-cream/65 mt-1.5 text-sm leading-relaxed">{f.copy}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>

  <Image
    src={firstTimeOut}
    alt="Illustrated river scene with a steelhead breaking the surface, pines along both banks"
    class="mt-12 block h-[30vh] max-h-[300px] min-h-[200px] w-full object-cover object-center md:h-[42vh] md:max-h-none"
    widths={[768, 1200, 1536]}
    sizes="100vw"
  />

  <TornEdge class="absolute inset-x-0 bottom-0" fill="var(--color-cream)" />
</section>

<section class="bg-cream text-ink">
  <div class="px-6 pt-10 pb-14 text-center md:px-8 md:pt-14">
    <p class="font-display text-ink/25 text-4xl leading-none" aria-hidden="true">&ldquo;</p>

    <div id="testimonials" class="mx-auto mt-3 max-w-xs md:max-w-md">
      {
        testimonials.map((t, i) => (
          <figure
            class:list={['testimonial', i !== 0 && 'hidden']}
            data-index={i}
            aria-hidden={i !== 0 ? 'true' : undefined}
          >
            <blockquote class="text-ink/80 text-sm leading-relaxed md:text-base">
              {t.quote}
            </blockquote>
            <figcaption class="eyebrow text-ink/70 mt-4">&mdash; {t.name}</figcaption>
          </figure>
        ))
      }
    </div>

    <div
      class="mt-7 flex items-center justify-center gap-2"
      role="tablist"
      aria-label="Testimonials"
    >
      {
        testimonials.map((t, i) => (
          <button
            type="button"
            role="tab"
            class:list={[
              'testimonial-dot rounded-full transition-all',
              i === 0 ? 'bg-ink h-1.5 w-6' : 'bg-ink/30 h-1.5 w-1.5',
            ]}
            data-index={i}
            aria-selected={i === 0 ? 'true' : 'false'}
            aria-label={`Show testimonial from ${t.name}`}
          />
        ))
      }
    </div>
  </div>
</section>

<script>
  const slides = Array.from(document.querySelectorAll<HTMLElement>('.testimonial'));
  const dots = Array.from(document.querySelectorAll<HTMLButtonElement>('.testimonial-dot'));

  function show(index: number) {
    slides.forEach((slide, i) => {
      const active = i === index;
      slide.classList.toggle('hidden', !active);
      if (active) slide.removeAttribute('aria-hidden');
      else slide.setAttribute('aria-hidden', 'true');
    });
    dots.forEach((dot, i) => {
      const active = i === index;
      dot.setAttribute('aria-selected', String(active));
      dot.classList.toggle('bg-ink', active);
      dot.classList.toggle('w-6', active);
      dot.classList.toggle('bg-ink/30', !active);
      dot.classList.toggle('w-1.5', !active);
    });
  }

  dots.forEach((dot) => {
    dot.addEventListener('click', () => show(Number(dot.dataset.index)));
  });
</script>
