---
import { Image } from 'astro:assets';
import firstTimeOutBackground from '../../assets/images/first-time-out-background.png';
import TornEdge from '../TornEdge.astro';

const items = [
  { label: 'Meet Time', value: 'Before first light — exact time set when you book' },
  { label: 'Trip Length', value: 'Full day on the water, typically 6–8 hours' },
  { label: 'Gear', value: 'Rods, tackle, and terminal gear all provided' },
  { label: 'What to Bring', value: 'Layered clothing, rain gear, and your license' },
];
---

<section class="bg-cream paper-fade-top relative overflow-hidden">
  <Image
    src={firstTimeOutBackground}
    alt="Illustrated river scene with a steelhead breaking the surface, pines along both banks"
    class="absolute inset-0 h-full w-full object-cover object-top"
    widths={[768, 1200, 1536]}
    sizes="100vw"
  />
  <TornEdge class="absolute inset-x-0 bottom-0" />

  <div class="relative z-10 mx-auto max-w-7xl px-4 pt-20 pb-24 md:px-8 md:pt-28 md:pb-32">
    <div class="art-wash mx-auto max-w-md text-center">
      <p class="font-display text-cedar tracking-widest">First Time Out?</p>
      <h2 class="text-ink mt-2 text-2xl md:text-3xl">What a Day Looks Like</h2>
    </div>

    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        items.map((item) => (
          <div class="border-ink/15 bg-cream/95 rounded-sm border p-5 shadow-sm">
            <p class="font-display text-ink/60 text-xs tracking-widest">{item.label}</p>
            <p class="mt-1.5 text-base">{item.value}</p>
          </div>
        ))
      }
    </div>

    <p class="text-ink/75 mx-auto mt-8 max-w-2xl text-center text-sm">
      Full details on licensing, what to pack, and what to expect are on the
      <a href="/fishing-information" class="text-cedar underline underline-offset-2">
        Fishing Information
      </a>
      page.
    </p>
  </div>
</section>
