---
// Not one of the mockup's screens; kept from the original brief. Placeholder sponsor
// marks - swap for real logo files.
const sponsors = ['Sponsor One', 'Sponsor Two', 'Sponsor Three', 'Sponsor Four'];
---

<section class="bg-cream text-ink">
  <div class="px-6 pt-12 pb-16 text-center md:px-8">
    <p class="eyebrow text-ink/70">Trusted By</p>
    <ul class="mt-6 flex flex-wrap items-center justify-center gap-x-8 gap-y-4">
      {
        sponsors.map((name) => (
          <li class="font-display text-ink/70 hover:text-ink text-sm tracking-[0.14em] uppercase transition-colors">
            {name}
          </li>
        ))
      }
    </ul>
  </div>
</section>
