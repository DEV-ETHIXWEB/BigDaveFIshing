---
import { Image } from 'astro:assets';
import { sponsors } from '../../lib/sponsors';
import SectionHeading from './SectionHeading.astro';

// The live site's sponsor rail, kept because these relationships are a credibility
// signal in guiding - Pro-Cure and Pautzke don't back someone who blanks. Theirs is a
// jerky carousel that clips logos mid-frame; this is one continuous track that never
// cuts a logo in half, and it pauses on hover so a name can actually be read.
//
// The list is rendered twice into one track: the animation translates exactly -50%, so
// the second copy lands where the first began and the loop has no seam. The duplicate
// is hidden from assistive tech, which would otherwise read every sponsor twice.
---

<section class="border-ink/10 border-y bg-white py-14 lg:py-16">
  <SectionHeading title="Our Sponsors" class="!max-w-xl" />

  <div class="marquee mt-10">
    <div class="marquee-track">
      {
        [0, 1].map((copy) => (
          <ul class="flex shrink-0 items-center" aria-hidden={copy === 1 ? 'true' : undefined}>
            {sponsors.map((sponsor) => (
              <li class="flex w-[9.5rem] shrink-0 items-center justify-center px-5 sm:w-[12rem] sm:px-7">
                {/* Full brand colour, always — these are other companies' marks and the
                    monochrome rule the rest of the chrome follows does not get to alter
                    them. They lift on hover instead, which the paused marquee makes
                    readable: the track stops the moment the pointer enters it, so the
                    logo being zoomed stays still rather than sliding out from under. */}
                <Image
                  src={sponsor.src}
                  alt={copy === 1 ? '' : sponsor.name}
                  widths={[200, 400]}
                  sizes="160px"
                  class="h-14 w-auto max-w-full object-contain transition-transform duration-300 ease-out hover:scale-110 sm:h-16"
                  loading="lazy"
                />
              </li>
            ))}
          </ul>
        ))
      }
    </div>
  </div>
</section>
