---
import { Image } from 'astro:assets';
import { Sunrise, Clock, Shirt } from 'lucide-react';
import firstTimeOutBackground from '../../assets/images/first-time-out-background.png';
import RodIcon from '../ui/RodIcon.astro';
import TornEdge from '../TornEdge.astro';

// Icon cards matching the supplied sheet: a filled dark disc with cream line art,
// and the label set below it.
const items = [
  { icon: Sunrise, label: 'Meet Time', value: 'Before first light — exact time set when you book' },
  { icon: Clock, label: 'Trip Length', value: 'Full day on the water, typically 6–8 hours' },
  { icon: null, label: 'Gear', value: 'Rods, tackle, and terminal gear all provided' },
  { icon: Shirt, label: 'What to Bring', value: 'Layered clothing, rain gear, and your license' },
];
---

<section class="bg-cream paper-fade-top relative overflow-hidden">
  <!-- Scaled up inside the section's overflow so the pines standing at the left and
       right edges of the illustration are cropped out, leaving the open river. -->
  <Image
    src={firstTimeOutBackground}
    alt="Illustrated river scene with a steelhead breaking the surface"
    class="absolute inset-0 h-full w-full scale-[1.45] object-cover object-top"
    widths={[768, 1200, 1536]}
    sizes="100vw"
  />
  <TornEdge class="absolute inset-x-0 bottom-0" />

  <div class="relative z-10 mx-auto max-w-7xl px-4 pt-20 pb-24 md:px-8 md:pt-28 md:pb-32">
    <div class="art-wash mx-auto max-w-md text-center">
      <p class="font-display text-cedar tracking-widest">First Time Out?</p>
      <h2 class="text-ink mt-2 text-2xl md:text-3xl">What a Day Looks Like</h2>
    </div>

    <ul class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      {
        items.map((item) => (
          <li class="text-center">
            <span class="bg-ink text-cream mx-auto flex h-24 w-24 items-center justify-center rounded-full">
              {item.icon ? (
                <item.icon size={38} strokeWidth={1.25} aria-hidden="true" />
              ) : (
                <RodIcon class="h-[38px] w-[38px]" />
              )}
            </span>
            <p class="font-display text-ink mt-4 text-lg tracking-[0.04em]">{item.label}</p>
            <p class="text-ink/70 mx-auto mt-1.5 max-w-[15rem] text-sm">{item.value}</p>
          </li>
        ))
      }
    </ul>

    <p class="text-ink/75 mx-auto mt-10 max-w-2xl text-center text-sm">
      Full details on licensing, what to pack, and what to expect are on the
      <a href="/fishing-information" class="text-cedar underline underline-offset-2">
        Fishing Information
      </a>
      page.
    </p>
  </div>
</section>
