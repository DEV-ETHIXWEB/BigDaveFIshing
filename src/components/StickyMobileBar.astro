---
import { Phone, CalendarCheck } from 'lucide-react';
import { business } from '../lib/business';
---

<div
  class="border-cream/10 bg-ink text-cream fixed inset-x-0 bottom-0 z-50 grid grid-cols-2 border-t lg:hidden"
  style="padding-bottom: env(safe-area-inset-bottom);"
>
  <a
    href={business.phoneHref}
    class="font-display border-cream/10 flex items-center justify-center gap-2 border-r py-3 tracking-[0.1em]"
  >
    <Phone size={18} aria-hidden="true" />
    Call Now
  </a>
  <a
    href="#book"
    class="bg-cedar font-display flex items-center justify-center gap-2 py-3 tracking-[0.1em]"
  >
    <CalendarCheck size={18} aria-hidden="true" />
    Book Now
  </a>
</div>
