---
// The small rule-with-a-diamond that sits under most headings in the design.
interface Props {
  class?: string;
  tone?: 'light' | 'dark';
}

const { class: className = '', tone = 'dark' } = Astro.props;
const stroke = tone === 'light' ? 'var(--color-cream)' : 'var(--color-ink)';
---

<svg
  viewBox="0 0 96 10"
  class:list={['h-2.5 w-24', className]}
  fill="none"
  aria-hidden="true"
  style={`color: ${stroke}`}
>
  <path d="M2 5h34M60 5h34" stroke="currentColor" stroke-width="1" opacity="0.55"></path>
  <path d="M48 1.5 52.5 5 48 8.5 43.5 5Z" fill="currentColor"></path>
</svg>
