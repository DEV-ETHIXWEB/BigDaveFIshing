---
import { Image } from 'astro:assets';
import { Menu, Phone } from 'lucide-react';
import { business } from '../lib/business';
import wood from '../assets/photos/wood-texture.png';
import badge from '../assets/photos/logo-badge.png';

// Below xl the brand rail is far too expensive in width, so it collapses to this:
// the same board texture and badge in a sticky bar, with the number kept visible
// rather than buried in the menu. Sticky, not absolute-over-hero, so the phone link
// stays reachable the whole way down the page.
---

<header class="board border-ink/10 sticky top-0 z-40 border-b xl:hidden">
  <div class="board-tex" style={`background-image: url(${wood.src});`} aria-hidden="true"></div>

  <div class="flex items-center justify-between gap-3 px-4 py-2.5">
    <a href="/" class="flex items-center gap-2.5" aria-label={`${business.name} — home`}>
      <Image
        src={badge}
        alt=""
        widths={[112, 224]}
        sizes="56px"
        class="h-14 w-auto"
        loading="eager"
      />
      <span class="font-display text-ink text-[0.95rem] leading-tight">
        Big Dave's<br /><span class="text-[0.72rem] opacity-70">Fishing Adventures</span>
      </span>
    </a>

    <div class="flex shrink-0 items-center gap-2">
      <a
        href={business.phoneHref}
        class="bg-ink text-cream hover:bg-graphite flex h-11 w-11 items-center justify-center transition-colors"
        aria-label={`Call ${business.phone}`}
      >
        <Phone size={19} strokeWidth={2} aria-hidden="true" />
      </a>

      <button
        id="menu-toggle"
        type="button"
        class="border-ink/25 text-ink hover:bg-ink hover:text-cream flex h-11 w-11 items-center justify-center border transition-colors"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open menu"
      >
        <Menu size={22} strokeWidth={2} aria-hidden="true" />
      </button>
    </div>
  </div>
</header>
