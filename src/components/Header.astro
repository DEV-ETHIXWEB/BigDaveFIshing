---
import { Menu } from 'lucide-react';
import { business, nav } from '../lib/business';

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<!-- Sits transparently over the hero artwork, as in the design: stacked wordmark on the
     left, menu button on the right. The desktop nav is additive - the mockup only
     specifies mobile, and dropping the nav entirely on a wide screen would be worse. -->
<header class="absolute inset-x-0 top-0 z-40">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-5 py-5 md:px-8">
    <a href="/" class="flex items-center gap-2.5" aria-label={`${business.name} — home`}>
      <!-- Ink linework on a transparent ground, so the mark sits on the pale artwork
           without carrying a black square or coin around with it. -->
      <img
        src="/art/logo-badge-ink-320.webp"
        srcset="/art/logo-badge-ink-320.webp 320w, /art/logo-badge-ink-640.webp 640w"
        sizes="(min-width: 768px) 88px, 68px"
        width="640"
        height="640"
        alt=""
        class="h-17 w-17 md:h-22 md:w-22"
      />
      <span class="font-display text-ink text-sm leading-tight tracking-[0.18em] uppercase">
        Big Dave's<br /><span class="text-[0.7rem] tracking-[0.3em]">Fishing Co.</span>
      </span>
    </a>

    <nav aria-label="Primary" class="hidden xl:block">
      <ul class="font-body flex items-center gap-7 text-[0.7rem] tracking-[0.2em] uppercase">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class:list={[
                  'hover:text-ink transition-colors',
                  isActive(item.href) ? 'text-ink' : 'text-ink/70',
                ]}
              >
                {item.short}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- Filled rather than a bare icon: the mockup's hero photos are dark, but this
         artwork is pale parchment at the top, so a light icon on its own disappears.
         The solid ink disc keeps it obvious over any part of the illustration. -->
    <button
      id="menu-toggle"
      type="button"
      class="bg-ink text-cream hover:bg-ink/85 flex h-11 w-11 items-center justify-center rounded-full shadow-md shadow-black/20 transition-colors xl:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Open menu"
    >
      <Menu size={22} strokeWidth={1.75} aria-hidden="true" />
    </button>
  </div>
</header>
