---
import { Phone, Menu, X } from 'lucide-react';
import { business, nav } from '../lib/business';
import BadgeLogo from './BadgeLogo.astro';
import HeaderVignette from './HeaderVignette.astro';

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="bg-ink text-cream border-cream/10 sticky top-0 z-50 border-b">
  <div class="mx-auto flex max-w-[100rem] items-stretch gap-4 px-4 md:px-6">
    <a
      href="/"
      class="flex shrink-0 items-center py-2"
      aria-label="Big Dave's Fishing Adventures — home"
    >
      <BadgeLogo class="text-cream h-14 w-14 xl:h-[4.5rem] xl:w-[4.5rem]" />
    </a>

    <div class="hidden shrink-0 self-stretch py-3 xl:block" aria-hidden="true">
      <span class="bg-cream/15 block h-full w-px"></span>
    </div>

    <nav aria-label="Primary" class="hidden min-w-0 flex-1 items-center xl:flex">
      <ul
        class="font-ui flex items-center gap-3 text-[13px] font-medium tracking-[0.14em] 2xl:gap-4"
      >
        {
          nav.map((item, i) => (
            <>
              {i > 0 && (
                <li aria-hidden="true" class="text-copper text-[10px] select-none">
                  &bull;
                </li>
              )}
              <li>
                <a
                  href={item.href}
                  aria-label={item.label}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                  class:list={[
                    'hover:text-copper relative block py-6 whitespace-nowrap uppercase transition-colors',
                    isActive(item.href) ? 'text-copper' : 'text-cream/90',
                  ]}
                >
                  {item.short}
                  {isActive(item.href) && (
                    <span class="bg-copper absolute inset-x-0 bottom-4 h-0.5" aria-hidden="true" />
                  )}
                </a>
              </li>
            </>
          ))
        }
      </ul>
    </nav>

    <div class="ml-auto hidden shrink-0 items-center gap-4 xl:flex">
      <div class="self-stretch py-3" aria-hidden="true">
        <span class="bg-cream/15 block h-full w-px"></span>
      </div>

      <HeaderVignette class="text-copper/70 h-14 w-[13rem]" />

      <a
        href="#book"
        class="bg-cream text-ink font-ui hover:bg-cedar hover:text-cream flex items-center gap-2 rounded-full px-6 py-3 text-[13px] font-semibold tracking-[0.14em] uppercase transition-colors"
      >
        Book Your Trip
        <svg width="14" height="18" viewBox="0 0 14 18" fill="none" aria-hidden="true">
          <path
            d="M7 1v9.2a3.4 3.4 0 1 1-4.6-3.2"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"></path>
          <path d="M4.4 1h5.2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"
          ></path>
        </svg>
      </a>
    </div>

    <a
      href={business.phoneHref}
      class="font-ui ml-auto flex items-center gap-2 self-center text-[13px] tracking-[0.1em] uppercase xl:hidden"
    >
      <Phone size={16} aria-hidden="true" />
      <span class="hidden sm:inline">{business.phone}</span>
    </a>

    <button
      id="menu-toggle"
      type="button"
      class="-mr-1 self-center p-3 xl:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Open menu"
    >
      <Menu size={26} aria-hidden="true" id="menu-icon-open" />
      <X size={26} aria-hidden="true" id="menu-icon-close" className="hidden" />
    </button>
  </div>

  <nav
    id="mobile-menu"
    aria-label="Mobile"
    class="border-cream/10 bg-ink hidden flex-col gap-1 border-t px-4 pb-4 xl:hidden"
  >
    {
      nav.map((item) => (
        <a
          href={item.href}
          aria-current={isActive(item.href) ? 'page' : undefined}
          class:list={[
            'border-cream/10 font-ui border-b py-3 tracking-[0.12em] uppercase',
            isActive(item.href) ? 'text-copper' : 'text-cream/90',
          ]}
        >
          {item.label}
        </a>
      ))
    }
    <a href={business.phoneHref} class="font-ui text-copper flex items-center gap-2 py-3 uppercase">
      <Phone size={18} aria-hidden="true" />
      {business.phone}
    </a>
    <a
      href="#book"
      class="bg-cream text-ink font-ui mt-2 rounded-full px-5 py-3 text-center text-xs font-semibold tracking-[0.15em] uppercase"
    >
      Book Your Trip
    </a>
  </nav>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  toggle?.addEventListener('click', () => {
    const isOpen = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!isOpen));
    toggle.setAttribute('aria-label', isOpen ? 'Open menu' : 'Close menu');
    menu?.classList.toggle('hidden');
    menu?.classList.toggle('flex');
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
  });
</script>
