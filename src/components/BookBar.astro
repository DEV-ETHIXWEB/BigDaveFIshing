---
import { business } from '../lib/business';

// The black "Book Today" bar that runs across the foot of every page on the live site.
// Pinned to the viewport rather than the document: it is the only call-to-action the
// original design has, and it converts far better when it never scrolls away.
//
// It clears the brand rail at xl+ (left: var(--rail-w)) so the two never overlap.
---

<div class="bg-ink text-cream fixed inset-x-0 bottom-0 z-40 xl:left-[var(--rail-w)]" data-book-bar>
  <div
    class="flex items-center justify-between gap-4 px-4 py-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] sm:px-8 xl:px-12 xl:py-5"
  >
    {
      /* The number is the single most valuable thing on the page, and at desktop widths
        the bar has room it was not using. Scaled up at xl rather than everywhere: on a
        phone the bar has to stay slim or it eats the content it sits over. */
    }
    <a
      href={business.phoneHref}
      class="font-display hover:text-silver text-[1.05rem] transition-colors sm:text-[1.35rem] xl:text-[1.75rem] 2xl:text-[2rem]"
    >
      Book Today: {business.phone}
    </a>

    {
      business.facebook && (
        <a
          href={business.facebook}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`${business.name} on Facebook`}
          class="text-ink hover:bg-silver flex h-9 w-9 shrink-0 items-center justify-center rounded-sm bg-white transition-colors sm:h-10 sm:w-10 xl:h-12 xl:w-12"
        >
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
            class="xl:h-6 xl:w-6"
          >
            <path d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5.02 3.66 9.18 8.44 9.94v-7.03H7.9v-2.91h2.54V9.85c0-2.5 1.49-3.89 3.77-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56v1.88h2.78l-.44 2.91h-2.34V22c4.78-.76 8.44-4.92 8.44-9.94Z" />
          </svg>
        </a>
      )
    }
  </div>
</div>
