---
import { business } from '../lib/business';

// The black "Book Today" bar that runs across the foot of every page on the live site.
// Pinned to the viewport rather than the document: it is the only call-to-action the
// original design has, and it converts far better when it never scrolls away.
//
// It clears the brand rail at xl+ (left: var(--rail-w)) so the two never overlap.
---

<div class="bg-ink text-cream fixed inset-x-0 bottom-0 z-40 xl:left-[var(--rail-w)]" data-book-bar>
  <div
    class="flex flex-wrap items-center gap-x-4 gap-y-2 px-4 py-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] sm:flex-nowrap sm:justify-between sm:px-8 xl:px-12 xl:py-5"
  >
    {
      /* The number is the single most valuable thing on the page, and at desktop widths
        the bar has room it was not using. Scaled up at xl rather than everywhere: on a
        phone the bar has to stay slim or it eats the content it sits over.

        Left untouched in size/text at every breakpoint - the phone number never
        shrinks or truncates to make room for anything else. Below sm, the bar simply
        wraps to a second row instead: at 320px the phone number alone (unwrapped)
        already takes 226 of the row's 288px, leaving nowhere near enough room for two
        legible buttons beside it on the same line without either shrinking the number
        or squeezing its own text into an ugly mid-string wrap. A clean second row reads
        as intentional; a phone number broken after "Book Today:" does not. */
    }
    <a
      href={business.phoneHref}
      class="font-display hover:text-silver text-[1.05rem] transition-colors sm:text-[1.35rem] xl:text-[1.75rem] 2xl:text-[2rem]"
    >
      Book Today: {business.phone}
    </a>

    {
      /* Grouped with the Facebook icon under one flex child, so the parent keeps pinning
        exactly two things apart - the phone on the left, everything else on the right -
        no matter how many icons/links end up in this group. `ml-auto` rather than the
        parent's `justify-between` is what actually pins it to the right: `justify-between`
        only has two things to space apart when both sit on the same line, but once the
        bar wraps below sm this group becomes the only thing on its own second line, and
        `ml-auto` keeps it flush right there too, where `justify-between` would have
        nothing left to push against and would drop it to the start instead. */
    }
    {
      /* Signed-out pair and signed-in link both ship in the markup, and a script below
         hides whichever does not apply. Nearly every page here is prerendered static
         HTML, so there is no request to read a session from at render time - the bar was
         inviting people who were already signed in, on their own account page, to log in
         again. `hidden` on the signed-in link is the right default: a first-time visitor
         is the common case, and it is what a reader with no JS should see. */
    }
    <div class="ml-auto flex shrink-0 items-center gap-2 sm:ml-0 sm:gap-3">
      <a
        href="/login"
        data-signed-out
        class="border-cream/40 text-cream hover:bg-cream hover:text-ink shrink-0 rounded-sm border px-2.5 py-1.5 text-[0.6875rem] font-medium tracking-[0.08em] uppercase transition-colors sm:px-3.5 sm:py-2 sm:text-xs xl:px-5 xl:py-2.5 xl:text-sm"
      >
        Login
      </a>
      <a
        href="/signup"
        data-signed-out
        class="bg-cream text-ink hover:bg-white shrink-0 rounded-sm px-2.5 py-1.5 text-[0.6875rem] font-medium tracking-[0.08em] uppercase transition-colors sm:px-3.5 sm:py-2 sm:text-xs xl:px-5 xl:py-2.5 xl:text-sm"
      >
        Sign Up
      </a>
      <a
        href="/account"
        data-signed-in
        hidden
        class="bg-cream text-ink hover:bg-white shrink-0 rounded-sm px-2.5 py-1.5 text-[0.6875rem] font-medium tracking-[0.08em] uppercase transition-colors sm:px-3.5 sm:py-2 sm:text-xs xl:px-5 xl:py-2.5 xl:text-sm"
      >
        My Account
      </a>

      {
        business.facebook && (
          <a
            href={business.facebook}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${business.name} on Facebook`}
            class="text-ink hover:bg-silver hidden h-9 w-9 shrink-0 items-center justify-center rounded-sm bg-white transition-colors sm:flex sm:h-10 sm:w-10 xl:h-12 xl:w-12"
          >
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
              class="xl:h-6 xl:w-6"
            >
              <path d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5.02 3.66 9.18 8.44 9.94v-7.03H7.9v-2.91h2.54V9.85c0-2.5 1.49-3.89 3.77-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56v1.88h2.78l-.44 2.91h-2.34V22c4.78-.76 8.44-4.92 8.44-9.94Z" />
            </svg>
          </a>
        )
      }
    </div>
  </div>
</div>

<script>
  // Swaps Login/Sign Up for My Account when a customer is signed in.
  //
  // Reads a non-httpOnly hint cookie that carries nothing but "1" - the real session
  // cookie stays httpOnly and unreadable here, and nothing on this bar is a permission
  // check. It only decides which of two links to show; /account verifies the actual
  // session for itself.
  //
  // Inline and synchronous so the swap happens with the first paint rather than
  // flickering "Login" at someone who is already signed in.
  (() => {
    const signedIn = document.cookie
      .split('; ')
      .some((entry) => entry.startsWith('big_dave_customer_present='));
    if (!signedIn) return;
    document.querySelectorAll('[data-signed-out]').forEach((el) => {
      (el as HTMLElement).hidden = true;
    });
    document.querySelectorAll('[data-signed-in]').forEach((el) => {
      (el as HTMLElement).hidden = false;
    });
  })();
</script>
