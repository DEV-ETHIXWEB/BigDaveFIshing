---
// Small etched landscape that sits between the nav and the booking button in the
// desktop header, echoing the illustrated sections further down the page.
// Purely decorative.
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<svg
  viewBox="0 0 220 64"
  class:list={['block', className]}
  fill="none"
  aria-hidden="true"
  preserveAspectRatio="xMidYMid meet"
>
  <!-- birds -->
  <path
    d="M150 12c1.6-1.8 3.2-1.8 4.4 0M158 8c1.4-1.6 2.8-1.6 3.9 0"
    stroke="currentColor"
    stroke-width="0.9"
    stroke-linecap="round"
    opacity="0.75"></path>

  <!-- far ridge -->
  <path
    d="M8 44 L34 22 L46 32 L58 18 L74 34 L88 26 L104 40 L120 30 L136 42 L152 34 L168 44 L188 32 L212 46"
    stroke="currentColor"
    stroke-width="1.1"
    stroke-linejoin="round"
    opacity="0.85"></path>

  <!-- ridge hatching -->
  <path
    d="M58 18 L52 30 M58 18 L65 28 M34 22 L29 32 M34 22 L40 30 M188 32 L183 40 M188 32 L194 40"
    stroke="currentColor"
    stroke-width="0.7"
    opacity="0.5"></path>

  <!-- pines along the near bank -->
  <g stroke="currentColor" stroke-width="0.9" stroke-linejoin="round" opacity="0.9">
    <path d="M20 52 L26 40 L32 52 Z"></path>
    <path d="M36 52 L41 43 L46 52 Z"></path>
    <path d="M172 52 L178 39 L184 52 Z"></path>
    <path d="M188 52 L193 44 L198 52 Z"></path>
  </g>

  <!-- waterline -->
  <path d="M4 54 H216" stroke="currentColor" stroke-width="1" opacity="0.6"></path>
  <path
    d="M22 58 H74 M96 58 H140 M158 58 H196"
    stroke="currentColor"
    stroke-width="0.7"
    opacity="0.35"></path>
</svg>
