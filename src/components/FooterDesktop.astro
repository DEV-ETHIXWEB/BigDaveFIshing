---
import { Phone, MapPin } from 'lucide-react';
import { business, footerLinks } from '../lib/business';
---

<footer class="bg-ink text-cream hidden pt-12 pb-12 xl:block">
  <div class="mx-auto grid max-w-7xl gap-10 px-4 md:grid-cols-3 md:px-8">
    <div>
      <p class="font-display text-xl tracking-wide">Big Dave's Fishing Adventures</p>
      <p class="text-cream/60 mt-3 max-w-xs text-sm">
        Guided steelhead and salmon trips on Oregon's coastal rivers, and lodging at the Wilson
        River Lodge.
      </p>
      <a
        href={business.facebook}
        target="_blank"
        rel="noopener noreferrer"
        class="text-cream/60 hover:text-copper mt-4 inline-flex items-center gap-2 text-sm"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path
            d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5.02 3.66 9.18 8.44 9.94v-7.03H7.9v-2.91h2.54V9.85c0-2.5 1.49-3.89 3.77-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56v1.88h2.78l-.44 2.91h-2.34V22c4.78-.76 8.44-4.92 8.44-9.94Z"
          ></path>
        </svg>
        Follow on Facebook
      </a>
    </div>

    <div>
      <p class="font-display text-copper tracking-wide">Get In Touch</p>
      <a
        href={business.phoneHref}
        class="font-display hover:text-copper mt-3 flex items-center gap-2 text-lg"
      >
        <Phone size={18} aria-hidden="true" />
        {business.phone}
      </a>
      <p class="text-cream/60 mt-2 flex items-start gap-2 text-sm">
        <MapPin size={18} className="mt-0.5 shrink-0" aria-hidden="true" />
        {business.serviceArea}
      </p>
    </div>

    <div>
      <p class="font-display text-copper tracking-wide">Site</p>
      <ul class="text-cream/60 mt-3 space-y-2 text-sm">
        {
          footerLinks.map((link) => (
            <li>
              <a href={link.href} class="hover:text-copper">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="text-cream/30 mx-auto mt-10 max-w-7xl px-4 text-xs md:px-8">
    &copy; {new Date().getFullYear()} Big Dave's Fishing Adventures. All rights reserved.
  </div>
</footer>
