---
import { Image } from 'astro:assets';
import { Phone, MapPin, Mail } from 'lucide-react';
import { business, nav, waiverLinks } from '../lib/business';
import badge from '../assets/photos/logo-badge.png';

// One responsive footer. The site used to carry two - a mobile one and a desktop one -
// which meant every contact detail existed twice and could drift apart. It did: the
// two disagreed about what the service area was.
//
// The bottom padding clears the fixed Book Today bar, which changes height at four
// breakpoints, so the padding has to as well. A flat pb-24 (96px) was not enough at
// either end: below sm the bar WRAPS to two rows (the phone number, then the account
// buttons) and adds a safe-area inset on a notched phone, coming to roughly 112px; and
// at 2xl the number is set at 2rem inside py-5, coming to about 93px with no margin
// left over. Both put the copyright line underneath the bar.
---

<footer class="bg-ink text-cream pb-32 sm:pb-24 xl:pb-28 2xl:pb-32">
  <div class="mx-auto grid max-w-6xl gap-10 px-6 pt-16 sm:px-10 md:grid-cols-3 lg:gap-12">
    <div>
      {
        /* Drawn at w-44 (176px), and it is painted solid white by brightness-0 invert, so
          encode quality buys nothing at all here - every pixel ends up one colour. */
      }
      {
        /* `width` as well as `widths` - see the note in BrandRail.astro; without it the
          `src` fallback is rendered at the source's full 2000px. */
      }
      <Image
        src={badge}
        alt=""
        width={352}
        widths={[176, 352]}
        sizes="176px"
        quality={70}
        class="h-auto w-44 brightness-0 invert"
        loading="lazy"
      />
      <p class="text-cream/65 mt-5 max-w-xs text-sm leading-relaxed">
        Guided Salmon and Steelhead trips along the Oregon coast, and lodging on the Wilson River
        with {business.hosts}.
      </p>

      {
        business.facebook && (
          <a
            href={business.facebook}
            target="_blank"
            rel="noopener noreferrer"
            class="text-cream/65 hover:text-silver mt-5 inline-flex items-center gap-2 text-sm transition-colors"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5.02 3.66 9.18 8.44 9.94v-7.03H7.9v-2.91h2.54V9.85c0-2.5 1.49-3.89 3.77-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56v1.88h2.78l-.44 2.91h-2.34V22c4.78-.76 8.44-4.92 8.44-9.94Z" />
            </svg>
            Follow on Facebook
          </a>
        )
      }
    </div>

    <div>
      <h2 class="text-silver text-[1.35rem]">Contact Us</h2>

      <ul class="mt-5 space-y-4 text-sm">
        <li class="flex items-start gap-3">
          <MapPin
            size={18}
            strokeWidth={1.5}
            className="mt-0.5 shrink-0 text-silver"
            aria-hidden="true"
          />
          <address class="text-cream/75 not-italic">
            {business.addressLines.map((line) => <span class="block">{line}</span>)}
          </address>
        </li>

        <li class="flex items-start gap-3">
          <Mail
            size={18}
            strokeWidth={1.5}
            className="mt-0.5 shrink-0 text-silver"
            aria-hidden="true"
          />
          <a
            href={business.emailHref}
            class="text-cream/75 hover:text-cream break-all transition-colors"
          >
            {business.email}
          </a>
        </li>

        <li class="flex items-start gap-3">
          <Phone
            size={18}
            strokeWidth={1.5}
            className="mt-0.5 shrink-0 text-silver"
            aria-hidden="true"
          />
          <a
            href={business.phoneHref}
            class="font-display hover:text-silver text-lg transition-colors"
          >
            {business.phone}
          </a>
        </li>
      </ul>
    </div>

    <!-- A real <nav> with its own accessible name. This was a bare <ul>, so the site's
         secondary link list was not reachable by landmark and read as loose list items;
         the name distinguishes it from the primary nav in the rail. -->
    <nav aria-labelledby="footer-explore">
      <h2 id="footer-explore" class="text-silver text-[1.35rem]">Explore</h2>

      <ul
        class="text-cream/70 mt-5 grid grid-cols-1 gap-y-2.5 text-sm sm:grid-cols-2 md:grid-cols-1"
      >
        {
          [...nav.slice(1), ...waiverLinks].map((link) => (
            <li>
              <a href={link.href} class="hover:text-silver transition-colors">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <div class="border-cream/10 mx-auto mt-12 max-w-6xl border-t px-6 pt-6 sm:px-10">
    <p class="text-cream/35 text-xs">
      &copy; {new Date().getFullYear()}{' '}
      {business.name}. All rights reserved.
    </p>
  </div>
</footer>
