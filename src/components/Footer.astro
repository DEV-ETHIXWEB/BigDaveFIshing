---
import { Phone, MapPin } from 'lucide-react';
import { business, footerLinks } from '../lib/business';
import Treeline from './ui/Treeline.astro';

// Screen 8: dark - heading, body, icon contact rows, treeline, stacked wordmark,
// social row. lucide ships no brand icons, so Facebook is an inline SVG.
const contact = [
  { icon: Phone, label: 'Call Us', value: business.phone, href: business.phoneHref },
  { icon: MapPin, label: 'Where We Fish', value: business.serviceArea, href: null },
];
---

<footer class="bg-ink text-cream relative pb-28 xl:hidden">
  <div class="mx-auto max-w-md px-6 pt-14 text-center md:px-8 md:pt-20">
    <h2 class="text-[1.5rem] md:text-3xl">Let's Plan Your Trip</h2>
    <p class="text-cream/65 mx-auto mt-5 max-w-xs text-sm">
      Get in touch and we'll help you plan the perfect adventure.
    </p>

    <ul class="mt-9 space-y-6 text-left">
      {
        contact.map((row) => (
          <li class="flex items-start gap-4">
            <row.icon size={20} strokeWidth={1.25} aria-hidden="true" className="mt-0.5 shrink-0" />
            <div>
              <p class="eyebrow text-cream/65">{row.label}</p>
              {row.href ? (
                <a href={row.href} class="hover:text-cream/80 mt-1 block text-sm">
                  {row.value}
                </a>
              ) : (
                <p class="mt-1 text-sm">{row.value}</p>
              )}
            </div>
          </li>
        ))
      }
    </ul>
  </div>

  <Treeline class="text-cream/10 mt-12 h-24 md:h-28" />

  <div class="-mt-6 px-6 text-center md:px-8">
    <img
      src="/art/logo-badge-cream-320.webp"
      srcset="/art/logo-badge-cream-320.webp 320w, /art/logo-badge-cream-640.webp 640w"
      sizes="128px"
      width="640"
      height="640"
      alt=""
      class="mx-auto h-32 w-32"
    />
    <p class="font-display mt-3 text-lg tracking-[0.18em] uppercase">Big Dave's</p>
    <p class="font-display text-cream/70 text-[0.7rem] tracking-[0.34em] uppercase">Fishing Co.</p>

    <div class="mt-6 flex items-center justify-center gap-5">
      <a
        href={business.facebook}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Big Dave's Fishing Adventures on Facebook"
        class="border-cream/25 text-cream/70 hover:text-cream hover:border-cream/60 flex h-10 w-10 items-center justify-center rounded-full border transition-colors"
      >
        <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path
            d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5.02 3.66 9.18 8.44 9.94v-7.03H7.9v-2.91h2.54V9.85c0-2.5 1.49-3.89 3.77-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56v1.88h2.78l-.44 2.91h-2.34V22c4.78-.76 8.44-4.92 8.44-9.94Z"
          ></path>
        </svg>
      </a>
    </div>

    <ul class="text-cream/45 mt-8 flex items-center justify-center gap-5 text-xs">
      {
        footerLinks.map((link) => (
          <li>
            <a href={link.href} class="hover:text-cream/80">
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <p class="text-cream/30 mt-4 text-[0.6875rem]">
      &copy; {new Date().getFullYear()} Big Dave's Fishing Adventures
    </p>
  </div>
</footer>
