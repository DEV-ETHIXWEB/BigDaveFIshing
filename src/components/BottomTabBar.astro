---
import { House, Fish, Images, Mail } from 'lucide-react';

// The floating rounded tab bar from the design. Four destinations; the first three
// scroll to sections on this page, Contact goes to the footer.
const tabs = [
  { icon: House, label: 'Home', href: '#top' },
  { icon: Fish, label: 'Trips', href: '#trips' },
  { icon: Images, label: 'Gallery', href: '/video-gallery' },
  { icon: Mail, label: 'Contact', href: '#book' },
];
---

<nav
  aria-label="Quick links"
  class="bw-region fixed inset-x-0 bottom-0 z-40 px-4 pb-[max(0.75rem,env(safe-area-inset-bottom))] xl:hidden"
>
  <ul
    class="bg-ink text-cream mx-auto flex max-w-md items-center justify-between gap-1 rounded-full px-3 py-2.5 shadow-lg shadow-black/30"
  >
    {
      tabs.map((tab) => (
        <li class="flex-1">
          <a
            href={tab.href}
            class="text-cream/75 hover:text-cream flex min-h-11 flex-col items-center justify-center gap-0.5 rounded-full transition-colors"
          >
            <tab.icon size={18} strokeWidth={1.4} aria-hidden="true" />
            <span class="font-body text-[0.625rem] tracking-[0.1em]">{tab.label}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>
