---
import { ArrowUpRight } from 'lucide-react';
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import Sponsors from '../../components/home/Sponsors.astro';
import { waiverDocuments } from '../../lib/waiver-text';
import { photos } from '../../lib/photos';
import { business } from '../../lib/business';

const links = [
  {
    href: '/waivers/fishing-adventure',
    title: 'Fishing Adventure Waiver',
    copy: 'For guided day trips on Tillamook Bay and the Wilson, Kilchis and Trask.',
    terms: waiverDocuments['fishing-adventure'].terms.length,
  },
  {
    href: '/waivers/lodge',
    title: 'Wilson River Lodge Waiver',
    copy: 'For guests staying at the lodge on the Wilson River.',
    terms: waiverDocuments.lodge.terms.length,
  },
];
---

<Layout
  title="Waivers | Big Dave's Fishing Adventures"
  description="Read the hold harmless, release and indemnification agreements for guided fishing trips and stays at the Wilson River Lodge."
>
  <PageHero
    eyebrow="Before your trip"
    title="Waivers"
    intro="Both agreements in full, so you can read them before you book."
    photo={photos.wilsonRiverLevel}
  />

  <section class="bg-cream py-14 lg:py-20">
    <div class="mx-auto max-w-3xl px-5 sm:px-8">
      <div class="mx-auto max-w-xl text-center" data-reveal>
        <p class="text-ink/70 text-[0.98rem] leading-relaxed">
          Pick the one that matches your trip. You can read it in full and sign it right there, from
          a phone or a computer: before you book, or any time before you come out.
        </p>
        <p class="text-ink/60 mt-3 text-sm leading-relaxed">
          If Big Dave has already sent your party a signing link, open that one instead, so it files
          everyone in the group together.
        </p>
      </div>

      <div class="mt-10 grid gap-4" data-reveal>
        {
          links.map((link) => (
            <a
              href={link.href}
              class="group border-ink/12 bg-paper hover:border-ink/40 flex items-start justify-between gap-6 border px-6 py-6 transition-colors sm:px-8"
            >
              <span class="min-w-0">
                <span class="font-display text-ink group-hover:text-graphite block text-[1.2rem] transition-colors sm:text-[1.35rem]">
                  {link.title}
                </span>
                <span class="text-ink/65 mt-2 block text-sm leading-relaxed">{link.copy}</span>
                <span class="eyebrow text-graphite mt-3 block">
                  Read in full · {link.terms} terms
                </span>
              </span>
              <ArrowUpRight
                size={20}
                strokeWidth={1.75}
                aria-hidden="true"
                className="text-graphite mt-1 shrink-0 transition-transform duration-300 group-hover:-translate-y-1 group-hover:translate-x-1"
              />
            </a>
          ))
        }
      </div>

      <p class="text-ink/55 mt-8 text-center text-sm">
        Lost your signing link? <a
          href={business.phoneHref}
          class="underline underline-offset-2 hover:text-ink">Call {business.phone}</a
        > and Big Dave will send a new one.
      </p>
    </div>
  </section>

  <Sponsors />
</Layout>
