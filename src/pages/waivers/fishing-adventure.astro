---
// Rendered per request, not prerendered: the page has to read the ?g= signing link and
// check it against the teams table before deciding whether to show a form at all.
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import WaiverPage from '../../components/waivers/WaiverPage.astro';
import { photos } from '../../lib/photos';
---

<Layout
  title="Fishing Adventure Waiver | Big Dave's Fishing Adventures"
  description="The hold harmless, release and indemnification agreement for guided fishing trips with Big Dave's Fishing Adventures. Read it in full and sign online from any phone or computer."
>
  <WaiverPage
    waiverType="fishing-adventure"
    eyebrow="Before your trip"
    heading="Fishing Adventure Waiver"
    intro="Read the agreement in full and sign it here — before you book, or any time before the trip."
    photo={photos.boatCatch}
  />
</Layout>
