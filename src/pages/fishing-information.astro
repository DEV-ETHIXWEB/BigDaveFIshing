---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Checkerboard from '../components/home/Checkerboard.astro';
import type { Row } from '../components/home/Checkerboard.astro';
import SectionHeading from '../components/home/SectionHeading.astro';
import Sponsors from '../components/home/Sponsors.astro';
import { photos } from '../lib/photos';
import { business, seasons } from '../lib/business';

// The three species descriptions are the live Fishing Information page's copy, verbatim.
const rows: Row[] = [
  {
    photo: photos.bayChinookPair,
    eyebrow: 'Oncorhynchus tshawytscha',
    heading: 'King/Chinook Salmon',
    body: [
      'King Salmon may spend between 1 to 5 years in the ocean before returning to their native streams to spawn, though the average is 3 to 4 years.',
      'The King Salmon is blue-green on the back and top of the head with silvery sides and white bellies, black spots on the upper half of its body with gray/black mouth coloration. King Salmon reach up to 60 inches in length and weigh up to 70 pounds, although King Salmon is generally up to 36 inches in length and weigh up to 30 pounds.',
    ],
  },
  {
    photo: photos.silverSalmon,
    eyebrow: 'Oncorhynchus kisutch',
    heading: 'Silver/Coho Salmon',
    body: [
      'Silver Salmon are found in coastal waters from Alaska to northern California.',
      'Silvers are extremely adaptable and are found in nearly all accessible bodies of fresh water, from large trans-boundary watersheds to small tributaries.',
    ],
  },
  {
    photo: photos.chumSalmon,
    eyebrow: 'Oncorhynchus keta',
    heading: 'Chum Salmon',
    body: [
      'Chum Salmon spawn in the lowermost reaches of rivers and streams, typically within 100 km of the ocean.',
      'Chum Salmon are found from Alaska to Oregon and can range from 12-20 lbs. They have unique calliquo markings that are fun fish to catch.',
    ],
  },
];

// Practical trip info. Everything here is drawn from the live site's own statements
// (tackle provided, sleds and drift boats, rivers fished, seasons) or is a plain fact of
// fishing in Oregon. Nothing about pricing, capacity or cancellation policy is asserted,
// because the live site never states any of it, those are for the client to confirm.
const bringList = [
  'Oregon fishing licence and the tags for what you’re after',
  'Rain gear and warm layers (the coast makes its own weather)',
  'Non-slip footwear, and waders in winter if you have them',
  'Polarised sunglasses and a hat',
  'Food and drink for the day',
  'A cooler for the drive home if you’re keeping fish',
];
---

<Layout
  title="Fishing Information | Species, Seasons & What to Bring | Big Dave's Fishing Adventures"
  description="What you'll be catching on the Oregon coast: King/Chinook, Silver/Coho and Chum Salmon, plus the season calendar and what to bring on a guided trip."
>
  <PageHero
    eyebrow="Before you go"
    title="Fishing Information"
    intro="The fish, the seasons, and what to have in the truck."
    photo={photos.cohoKing}
  />

  <Checkerboard rows={rows} startIndex={0} />

  <section class="bg-ink py-16 lg:py-20">
    <SectionHeading
      eyebrow="Season calendar"
      title="When To Come"
      intro="Conditions change day to day and river to river. Call and we'll tell you what's running."
      tone="light"
    />

    <div class="mx-auto mt-10 max-w-3xl px-6 sm:px-10" data-reveal>
      <dl>
        {
          seasons.map((season) => (
            <div class="border-cream/15 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 border-b py-5 last:border-b-0">
              <dt class="font-display text-cream text-[1.25rem] lg:text-[1.5rem]">{season.fish}</dt>
              <dd class="font-ui text-silver text-[0.85rem] tracking-[0.14em] uppercase">
                {season.window}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="bg-paper py-16 lg:py-20">
    <SectionHeading eyebrow="Packing" title="What To Bring" />

    <div class="mx-auto mt-10 max-w-3xl px-6 sm:px-10" data-reveal>
      <ul class="grid gap-x-10 gap-y-4 sm:grid-cols-2">
        {
          bringList.map((item) => (
            <li class="text-ink/75 flex gap-3 text-[0.98rem] leading-relaxed">
              <span class="bg-ink mt-2.5 h-1.5 w-1.5 shrink-0 rotate-45" aria-hidden="true" />
              {item}
            </li>
          ))
        }
      </ul>

      <p class="text-ink/60 mt-8 text-center text-sm">
        Tackle, gear and life jackets are provided, so you don’t need to bring a rod.
      </p>

      <div class="mt-8 text-center">
        <a href={business.phoneHref} class="btn btn-solid-dark">Call {business.phone}</a>
      </div>
    </div>
  </section>

  <Sponsors />
</Layout>
