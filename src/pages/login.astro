---
export const prerender = false;
import Layout from '../layouts/Layout.astro';

const error = Astro.url.searchParams.get('error') === '1';
const lockedFor = Number(Astro.url.searchParams.get('locked') || 0);
const lockedMinutes = lockedFor > 0 ? Math.max(1, Math.ceil(lockedFor / 60)) : 0;
---

<Layout
  title="Log In | Big Dave's Fishing Adventures"
  description="Log in to your Big Dave's Fishing Adventures account."
>
  <section
    class="bg-paper flex min-h-[70vh] items-center justify-center px-6 pt-28 pb-20 sm:px-10 md:pt-36"
  >
    <form
      action="/api/customer/login"
      method="post"
      class="w-full max-w-md border border-ink/15 bg-white p-7 shadow-[8px_8px_0_#191919] md:p-9"
    >
      <p class="eyebrow text-graphite text-center">Welcome back</p>
      <h1 class="text-ink mt-2 text-center text-3xl">Log In</h1>
      <p class="text-graphite mt-3 text-center text-sm">
        New here? <a href="/signup" class="text-ink underline underline-offset-2"
          >Create an account</a
        >.
      </p>

      {
        error && (
          <p class="mt-5 border border-red-900/20 bg-red-900/5 px-3 py-2 text-sm">
            Incorrect email or password.
          </p>
        )
      }
      {
        lockedMinutes > 0 && (
          <p class="mt-5 border border-red-900/20 bg-red-900/5 px-3 py-2 text-sm">
            Too many failed attempts. Try again in about {lockedMinutes} minute
            {lockedMinutes === 1 ? '' : 's'}.
          </p>
        )
      }

      <label class="mt-6 block text-sm font-medium"
        >Email
        <input
          required
          type="email"
          name="email"
          autocomplete="email"
          class="border-ink/20 focus:border-ink mt-1 w-full border px-3 py-3 outline-none"
        />
      </label>
      <label class="mt-4 block text-sm font-medium"
        >Password
        <input
          required
          type="password"
          name="password"
          autocomplete="current-password"
          class="border-ink/20 focus:border-ink mt-1 w-full border px-3 py-3 outline-none"
        />
      </label>
      <button class="btn btn-solid-dark mt-6 w-full" type="submit">Log In</button>
    </form>
  </section>
</Layout>
