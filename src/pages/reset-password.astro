---
export const prerender = false;
import Layout from '../layouts/Layout.astro';

const token = Astro.url.searchParams.get('token') || '';
const errorCode = Astro.url.searchParams.get('error');
const FIELD_PROBLEM: Record<string, string> = {
  password: 'Use a password of at least 8 characters.',
  confirm: 'Those passwords do not match.',
  'rate-limited': 'Too many attempts from this connection. Please try again shortly.',
  'invalid-token':
    'That reset link is invalid or has expired. Reset links work once and only for an hour.',
};
const problem = errorCode ? (FIELD_PROBLEM[errorCode] ?? 'Check the details and try again.') : null;

// A GET with no token at all is never a real reset link - the form has nothing to
// submit against, so it is honest to say so up front rather than let them fill it in
// and fail at the very end.
const missingToken = !token && errorCode !== 'invalid-token';
---

<Layout
  title="Reset Password | Big Dave's Fishing Adventures"
  description="Choose a new password for your Big Dave's Fishing Adventures account."
>
  <section
    class="bg-paper flex min-h-[70vh] items-center justify-center px-6 pt-28 pb-20 sm:px-10 md:pt-36"
  >
    {
      missingToken || errorCode === 'invalid-token' ? (
        <div class="w-full max-w-md border border-ink/15 bg-white p-7 text-center shadow-[8px_8px_0_#191919] md:p-9">
          <p class="eyebrow text-graphite">Reset link</p>
          <h1 class="text-ink mt-2 text-3xl">Link Invalid or Expired</h1>
          <p class="text-graphite mt-4 text-sm">
            {missingToken
              ? 'This page needs a reset link to work - open the link from your email, or request a new one.'
              : problem}
          </p>
          <p class="text-graphite mt-4 text-sm">
            <a href="/forgot-password" class="text-ink underline underline-offset-2">
              Request a new link
            </a>
          </p>
        </div>
      ) : (
        <form
          action="/api/customer/reset-password"
          method="post"
          class="w-full max-w-md border border-ink/15 bg-white p-7 shadow-[8px_8px_0_#191919] md:p-9"
        >
          <p class="eyebrow text-graphite text-center">Reset password</p>
          <h1 class="text-ink mt-2 text-center text-3xl">Choose a New Password</h1>

          {problem && (
            <p class="mt-5 border border-red-900/20 bg-red-900/5 px-3 py-2 text-sm">{problem}</p>
          )}

          <input type="hidden" name="token" value={token} />

          <label class="mt-6 block text-sm font-medium">
            New password
            <input
              required
              type="password"
              name="password"
              autocomplete="new-password"
              minlength="8"
              class="border-ink/20 focus:border-ink mt-1 w-full border px-3 py-3 outline-none"
            />
          </label>
          <label class="mt-4 block text-sm font-medium">
            Confirm new password
            <input
              required
              type="password"
              name="confirmPassword"
              autocomplete="new-password"
              minlength="8"
              class="border-ink/20 focus:border-ink mt-1 w-full border px-3 py-3 outline-none"
            />
          </label>
          <button class="btn btn-solid-dark mt-6 w-full" type="submit">
            Set New Password
          </button>
        </form>
      )
    }
  </section>
</Layout>
