---
export const prerender = false;
import Layout from '../layouts/Layout.astro';

const errorCode = Astro.url.searchParams.get('error');
const FIELD_PROBLEM: Record<string, string> = {
  'invalid-email': 'Enter a valid email address.',
  'rate-limited': 'Too many attempts from this connection. Please try again shortly.',
  unavailable:
    'Password reset is temporarily unavailable. Please call (503) 538-5607 and Big Dave can help you back in.',
};
const problem = errorCode ? (FIELD_PROBLEM[errorCode] ?? 'Check the details and try again.') : null;
const sent = Astro.url.searchParams.get('sent') === '1';
---

<Layout
  title="Forgot Password | Big Dave's Fishing Adventures"
  description="Reset your Big Dave's Fishing Adventures account password."
>
  <section
    class="bg-paper flex min-h-[70vh] items-center justify-center px-6 pt-28 pb-20 sm:px-10 md:pt-36"
  >
    {
      sent ? (
        <div class="w-full max-w-md border border-ink/15 bg-white p-7 text-center shadow-[8px_8px_0_#191919] md:p-9">
          <p class="eyebrow text-graphite">Check your email</p>
          <h1 class="text-ink mt-2 text-3xl">Link on its way</h1>
          <p class="text-graphite mt-4 text-sm">
            If an account exists for that email address, a password reset link is on its way. It
            works once and expires in an hour.
          </p>
          <p class="text-graphite mt-4 text-sm">
            <a href="/login" class="text-ink underline underline-offset-2">
              Back to Log In
            </a>
          </p>
        </div>
      ) : (
        <form
          action="/api/customer/forgot-password"
          method="post"
          class="w-full max-w-md border border-ink/15 bg-white p-7 shadow-[8px_8px_0_#191919] md:p-9"
        >
          <p class="eyebrow text-graphite text-center">Forgot password</p>
          <h1 class="text-ink mt-2 text-center text-3xl">Reset Your Password</h1>
          <p class="text-graphite mt-3 text-center text-sm">
            Enter the email on your account and we'll send a link to reset your password.
          </p>

          {problem && (
            <p class="mt-5 border border-red-900/20 bg-red-900/5 px-3 py-2 text-sm">{problem}</p>
          )}

          <label class="mt-6 block text-sm font-medium">
            Email
            <input
              required
              type="email"
              name="email"
              autocomplete="email"
              class="border-ink/20 focus:border-ink mt-1 w-full border px-3 py-3 outline-none"
            />
          </label>
          <button class="btn btn-solid-dark mt-6 w-full" type="submit">
            Send Reset Link
          </button>
          <p class="text-graphite mt-5 text-center text-sm">
            <a href="/login" class="text-ink underline underline-offset-2">
              Back to Log In
            </a>
          </p>
        </form>
      )
    }
  </section>
</Layout>
