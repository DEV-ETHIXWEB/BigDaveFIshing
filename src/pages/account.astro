---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import { db, ensureSchema, type Customer, type WaiverRecord, type Booking } from '../lib/db';
import { validCustomerSession, CUSTOMER_HINT_COOKIE } from '../lib/customer-auth';
import { envSetting } from '../lib/env';
import { formatSignedAt, formatTripDate } from '../lib/dates';
import { tripTypeLabels } from '../lib/booking-enquiry';

// A real landing spot for a signed-in customer: confirms the account, shows their own
// waivers and enquiries, gives a way to sign out. What it does NOT show is anyone else's
// - both queries below filter on this customer's own id, the same id the session cookie
// names, never anything read from the request.
//
// Checked here rather than in src/middleware.ts: that middleware is deliberately scoped
// to /admin, a second sitewide gate for one page would be more machinery than the
// single check below.
const secret = envSetting('CUSTOMER_SESSION_SECRET');
const session = await validCustomerSession(Astro.cookies.get('big_dave_customer')?.value, secret);

if (!session) {
  return Astro.redirect('/login', 303);
}

await ensureSchema();
const result = await db.execute({
  sql: 'SELECT * FROM customers WHERE id = ?',
  args: [session.id],
});
const customer = result.rows[0] as unknown as Customer | undefined;

// The session named a real, signed id, but either the row is gone (deleted directly in
// the database, the only way that can happen today) or its session_version has moved on
// since this cookie was issued - a password reset since this device last logged in.
// Both cases are treated the same as no session at all.
if (!customer || customer.session_version !== session.sessionVersion) {
  Astro.cookies.delete('big_dave_customer', { path: '/' });
  Astro.cookies.delete(CUSTOMER_HINT_COOKIE, { path: '/' });
  return Astro.redirect('/login', 303);
}

// Capped rather than paginated, same reasoning as the admin activity log: this is a
// customer glancing at their own recent history, not an archive someone pages back
// through. signature_png is deliberately left out of the column list - this page never
// needs it, and it is the one column expensive enough to matter (see WaiverListRow's
// own comment in db.ts).
const [waiversResult, bookingsResult] = await Promise.all([
  db.execute({
    sql: `SELECT id, waiver_type, trip_date, group_leader_name, signed_at
          FROM waivers WHERE customer_id = ? ORDER BY signed_at DESC LIMIT 20`,
    args: [customer.id],
  }),
  db.execute({
    sql: `SELECT id, trip_type, message, created_at
          FROM bookings WHERE customer_id = ? ORDER BY created_at DESC LIMIT 20`,
    args: [customer.id],
  }),
]);
const waivers = waiversResult.rows as unknown as Pick<
  WaiverRecord,
  'id' | 'waiver_type' | 'trip_date' | 'group_leader_name' | 'signed_at'
>[];
const bookings = bookingsResult.rows as unknown as Pick<
  Booking,
  'id' | 'trip_type' | 'message' | 'created_at'
>[];

const waiverTypeLabels: Record<string, string> = {
  'fishing-adventure': 'Fishing Adventure',
  lodge: 'Wilson River Lodge',
};

const params = Astro.url.searchParams;
const justVerified = params.get('verified') === '1';
const verifyError = params.get('verify-error') === '1';
const justResent = params.get('resent') === '1';
const resendErrorCode = params.get('resend-error');
const resendError = resendErrorCode
  ? resendErrorCode === 'rate-limited'
    ? 'Too many attempts from this connection. Please try again shortly.'
    : 'Could not send the email right now. Please try again shortly, or call (503) 538-5607.'
  : null;
---

<Layout title="My Account | Big Dave's Fishing Adventures" description="Your account.">
  <section class="bg-paper min-h-[70vh] px-6 pt-28 pb-20 sm:px-10 md:pt-36">
    <div
      class="mx-auto w-full max-w-md border border-ink/15 bg-white p-7 text-center shadow-[8px_8px_0_#191919] md:p-9"
    >
      <p class="eyebrow text-graphite">My Account</p>
      <h1 class="text-ink mt-2 text-3xl">Welcome back, {customer.name.split(/\s+/)[0]}</h1>
      <p class="text-graphite mt-3 text-sm">{customer.email}</p>

      {
        justVerified && (
          <p class="mt-4 border border-green-900/20 bg-green-900/5 p-3 text-sm">
            Email confirmed. Thanks!
          </p>
        )
      }
      {
        justResent && (
          <p class="mt-4 border border-green-900/20 bg-green-900/5 p-3 text-sm">
            Confirmation email sent. Check your inbox.
          </p>
        )
      }
      {
        resendError && (
          <p class="mt-4 border border-red-900/20 bg-red-900/5 p-3 text-sm">{resendError}</p>
        )
      }
      {
        !customer.email_verified_at && (
          <div class="mt-4 border border-ink/20 bg-white p-3 text-sm">
            <p class="text-graphite">
              {verifyError
                ? "That confirmation link didn't work - it may have expired or already been used."
                : 'Please confirm your email address.'}
            </p>
            <form action="/api/customer/resend-verification" method="post" class="mt-2">
              <button type="submit" class="text-ink underline underline-offset-2">
                Resend confirmation email
              </button>
            </form>
          </div>
        )
      }

      <form action="/api/customer/logout" method="post" class="mt-8">
        <button class="btn btn-outline-dark w-full" type="submit">Sign Out</button>
      </form>
    </div>

    <div class="mx-auto mt-10 grid max-w-3xl gap-8 md:grid-cols-2">
      <div>
        <p class="eyebrow text-graphite">Your waivers</p>
        <h2 class="text-ink mt-1 text-xl">Signed waivers</h2>
        {
          waivers.length === 0 ? (
            <p class="text-graphite mt-3 text-sm">
              Nothing yet. A waiver you sign while logged in shows up here.
            </p>
          ) : (
            <ul class="mt-3 divide-y divide-ink/10 border border-ink/15 bg-white">
              {waivers.map((waiver) => (
                <li class="p-3 text-sm">
                  <p class="text-ink font-medium">
                    {waiverTypeLabels[waiver.waiver_type] ?? waiver.waiver_type}
                  </p>
                  <p class="text-graphite mt-0.5">
                    {waiver.trip_date ? `Trip ${formatTripDate(waiver.trip_date)} · ` : ''}
                    Signed {formatSignedAt(waiver.signed_at)}
                  </p>
                </li>
              ))}
            </ul>
          )
        }
      </div>

      <div>
        <p class="eyebrow text-graphite">Your enquiries</p>
        <h2 class="text-ink mt-1 text-xl">Booking enquiries</h2>
        {
          bookings.length === 0 ? (
            <p class="text-graphite mt-3 text-sm">
              Nothing yet. A booking enquiry you send while logged in shows up here.
            </p>
          ) : (
            <ul class="mt-3 divide-y divide-ink/10 border border-ink/15 bg-white">
              {bookings.map((booking) => (
                <li class="p-3 text-sm">
                  <p class="text-ink font-medium">
                    {tripTypeLabels[booking.trip_type as keyof typeof tripTypeLabels] ??
                      booking.trip_type}
                  </p>
                  <p class="text-graphite mt-0.5">Sent {formatSignedAt(booking.created_at)}</p>
                  {booking.message && (
                    <p class="text-graphite/80 mt-1 line-clamp-2">{booking.message}</p>
                  )}
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </div>
  </section>
</Layout>
