---
export const prerender = false;
import AdminLayout from '../../layouts/AdminLayout.astro';
import { adminSecretIsWeak } from '../../lib/admin-secret';

const error = Astro.url.searchParams.get('error') === '1';
const next = Astro.url.searchParams.get('next') || '/admin/waivers';

// Seconds remaining on a rate-limit lockout, passed back by the login endpoint.
const lockedFor = Number(Astro.url.searchParams.get('locked') || 0);
const lockedMinutes = lockedFor > 0 ? Math.max(1, Math.ceil(lockedFor / 60)) : 0;

// Shown only in production, and only to someone already at the staff door. It is a
// deployment mistake worth being loud about: without ADMIN_SESSION_SECRET the session
// cookie is signed with the password itself, so a weak password is also a weak key.
const weakSecret = import.meta.env.PROD && adminSecretIsWeak();
---

<AdminLayout title="Staff sign in"
  ><section class="flex min-h-[calc(100vh-57px)] items-center justify-center px-5 py-12">
    <form
      action="/api/admin/login"
      method="post"
      class="w-full max-w-md border border-ink/15 bg-white p-7 shadow-[8px_8px_0_#191919] md:p-9"
    >
      <img
        src="/art/logo-badge-ink-320.webp"
        alt="Big Dave's Fishing"
        class="mx-auto h-24 w-24 object-contain"
      /><p class="eyebrow mt-5 text-center text-ink/65">Big Dave&rsquo;s Fishing</p><h1
        class="mt-2 text-center text-3xl"
      >
        Staff sign in
      </h1><p class="mt-3 text-center text-sm text-ink/60">
        Waiver teams and signed guest records.
      </p>{
        error && (
          <p class="mt-5 border border-red-900/20 bg-red-900/5 px-3 py-2 text-sm">
            Incorrect username or password.
          </p>
        )
      }{
        lockedMinutes > 0 && (
          <p class="mt-5 border border-red-900/20 bg-red-900/5 px-3 py-2 text-sm">
            Too many failed attempts. Try again in about {lockedMinutes} minute
            {lockedMinutes === 1 ? '' : 's'}.
          </p>
        )
      }{
        weakSecret && (
          <p class="mt-5 border border-amber-900/25 bg-amber-900/5 px-3 py-2 text-xs leading-relaxed">
            <strong>Set ADMIN_SESSION_SECRET.</strong> Sessions are currently signed with the admin
            password, so the cookie is only as hard to forge as that password is to guess.
          </p>
        )
      }<input type="hidden" name="next" value={next} /><label class="mt-6 block text-sm font-medium"
        >Username<input
          required
          name="username"
          autocomplete="username"
          class="mt-1 w-full border border-ink/20 px-3 py-3 outline-none focus:border-ink"
        /></label
      ><label class="mt-4 block text-sm font-medium"
        >Password<input
          required
          type="password"
          name="password"
          autocomplete="current-password"
          class="mt-1 w-full border border-ink/20 px-3 py-3 outline-none focus:border-ink"
        /></label
      ><button class="btn btn-solid-dark mt-6 w-full" type="submit">Sign in</button>
    </form>
  </section></AdminLayout
>
