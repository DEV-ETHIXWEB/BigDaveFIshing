---
export const prerender = false;
import AdminLayout from '../../layouts/AdminLayout.astro';
import {
  db,
  ensureSchema,
  WAIVER_LIST_COLUMNS,
  type WaiverListRow,
  type WaiverTeam,
} from '../../lib/db';

await ensureSchema();

// Explicit columns, never SELECT *: signature_png is a base64 blob and pulling 60 of them
// into this page made it 1 MB. Each signature is fetched separately, lazily, below.
// The two queries are independent, so they run together rather than one after the other.
const [waiverResult, teamResult] = await Promise.all([
  db.execute(`SELECT ${WAIVER_LIST_COLUMNS} FROM waivers ORDER BY signed_at DESC`),
  db.execute('SELECT * FROM waiver_teams ORDER BY team_number ASC'),
]);

const waivers = waiverResult.rows as unknown as WaiverListRow[];
const teams = teamResult.rows as unknown as WaiverTeam[];
const signedByGroup = new Map<string, WaiverListRow[]>();
for (const waiver of waivers) {
  const key = waiver.group_code || `manual:${waiver.group_leader_name || 'ungrouped'}`;
  if (!signedByGroup.has(key)) signedByGroup.set(key, []);
  signedByGroup.get(key)!.push(waiver);
}
const manualGroups = [...signedByGroup.entries()].filter(([key]) => key.startsWith('manual:'));
const appUrl = Astro.url.origin;
const created = Astro.url.searchParams.get('team-created') === '1';
const exists = Astro.url.searchParams.get('team-exists') === '1';
const badTeam = Astro.url.searchParams.get('team-error') === '1';
---

<AdminLayout title="Waiver dashboard">
  <section class="mx-auto max-w-6xl px-5 py-8 md:px-8 md:py-12">
    <header class="flex flex-wrap items-start justify-between gap-5 border-b border-ink/15 pb-7">
      <div>
        <img src="/art/logo-badge-ink-160.webp" alt="Big Dave's Fishing" class="h-14 w-14" /><p
          class="eyebrow mt-4 text-ink/65"
        >
          Staff dashboard
        </p><h1 class="mt-1 text-3xl md:text-5xl">Waiver teams</h1><p
          class="mt-2 text-sm text-ink/60"
        >
          {waivers.length} signed waiver{waivers.length === 1 ? '' : 's'} across {teams.length} team{
            teams.length === 1 ? '' : 's'
          }.
        </p>

        <!-- Tells Dave the page is watching, so he doesn't sit there refreshing it while
             a group signs. The script rewrites this text when something changes. -->
        <p class="mt-2 flex items-center gap-2 text-xs text-ink/50">
          <span class="inline-block h-1.5 w-1.5 rounded-full bg-green-700" aria-hidden="true"
          ></span>
          <span data-live-status>Watching for new waivers</span>
        </p>
      </div>
      <form action="/api/admin/logout" method="post">
        <button class="border border-ink/25 px-4 py-2 text-sm">Sign out</button>
      </form>
    </header>

    <div class="mt-8 grid gap-8 lg:grid-cols-[minmax(0,1fr)_22rem]">
      <div class="order-2 lg:order-1">
        <h2 class="text-2xl">Teams & signed guests</h2>
        {
          teams.length === 0 && (
            <p class="mt-5 text-sm text-ink/60">Create the first team link on the right.</p>
          )
        }
        <div class="mt-5 space-y-6">
          {
            teams.map((team) => {
              const members = signedByGroup.get(team.group_code) || [];
              const link = `${appUrl}/waivers/${team.waiver_type}?g=${team.group_code}`;
              return (
                <article class="border border-ink/15 bg-white">
                  <>
                    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-ink/15 bg-ink px-5 py-4 text-cream">
                      <>
                        <div>
                          <>
                            <p class="eyebrow text-cream/65">Team {team.team_number}</p>
                            <h3 class="mt-1 text-xl">{team.leader_name}</h3>
                          </>
                        </div>
                        <p class="text-sm text-cream/75">
                          {members.length} signed{team.trip_date ? ` · ${team.trip_date}` : ''}
                        </p>
                      </>
                    </div>
                    <div class="p-5">
                      <div class="mt-2 flex gap-2">
                        <>
                          <input
                            readonly
                            value={link}
                            class="min-w-0 flex-1 border border-ink/20 bg-cream px-3 py-2 text-xs"
                          />
                          <button
                            type="button"
                            class="border border-ink px-3 text-xs"
                            data-copy={link}
                          >
                            Copy
                          </button>
                        </>
                      </div>

                      {/* Copy alone means leaving the page, opening Messages and pasting.
                          These hand the link straight to the app it gets sent from.
                          The Share button uses the native share sheet where one exists
                          (any phone, Safari, Edge) and stays hidden where it doesn't. */}
                      <div class="mt-2 flex flex-wrap gap-2 text-xs">
                        <button
                          type="button"
                          hidden
                          class="border border-ink/30 px-3 py-1.5"
                          data-share={link}
                          data-share-title={`${team.waiver_type === 'lodge' ? 'Lodge' : 'Fishing'} waiver — team ${team.team_number}`}
                        >
                          Share…
                        </button>
                        <a
                          class="border border-ink/30 px-3 py-1.5"
                          href={`sms:?&body=${encodeURIComponent(`Big Dave's Fishing — please sign your waiver before the trip: ${link}`)}`}
                        >
                          Text
                        </a>
                        <a
                          class="border border-ink/30 px-3 py-1.5"
                          href={`mailto:?subject=${encodeURIComponent("Waiver for your trip with Big Dave's Fishing")}&body=${encodeURIComponent(`Please sign your waiver before the trip:\n\n${link}\n\nIt only takes a minute — name, phone, emergency contact and a signature.\n\nBig Dave's Fishing Adventures`)}`}
                        >
                          Email
                        </a>
                        <a
                          class="border border-ink/30 px-3 py-1.5"
                          href={link}
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          Open
                        </a>
                      </div>
                      {members.length === 0 ? (
                        <p class="mt-5 text-sm text-ink/55">No signed guests yet.</p>
                      ) : (
                        <ul class="mt-5 divide-y divide-ink/10">
                          {members.map((member) => (
                            <li class="flex flex-wrap items-center gap-4 py-3">
                              {/* Fetched per-signature and lazily: only the ones actually
                                  scrolled into view are ever requested, and each is
                                  cached immutably after that. width/height are set so
                                  the row does not reflow as they arrive. */}
                              <img
                                src={`/api/admin/signature/${member.id}`}
                                alt={`Signature of ${member.guest_name}`}
                                width="96"
                                height="36"
                                loading="lazy"
                                decoding="async"
                                class="h-9 w-24 border border-ink/15 bg-cream object-contain"
                              />
                              <div class="min-w-40 flex-1">
                                <p class="font-medium">{member.guest_name}</p>
                                <p class="text-xs text-ink/60">
                                  {member.guest_phone}
                                  {member.guest_email ? ` · ${member.guest_email}` : ''}
                                </p>
                              </div>
                              <p class="text-xs text-ink/55">
                                Signed {new Date(member.signed_at + 'Z').toLocaleString()}
                              </p>
                            </li>
                          ))}
                        </ul>
                      )}
                    </div>
                  </>
                </article>
              );
            })
          }
          {
            manualGroups.map(([key, members]) => (
              <article class="border border-ink/15 bg-cream p-5">
                <>
                  <p class="eyebrow text-ink/60">No team link</p>
                  <h3 class="mt-1 text-xl">{key.replace('manual:', '')}</h3>
                  <p class="mt-2 text-sm text-ink/60">
                    {members.map((member) => member.guest_name).join(', ')}
                  </p>
                </>
              </article>
            ))
          }
        </div>
      </div>
      <aside class="order-1 border border-ink/15 bg-white p-5 lg:order-2 lg:self-start">
        <p class="eyebrow text-ink/60">New trip</p><h2 class="mt-2 text-2xl">
          Create a team link
        </h2><p class="mt-2 text-sm text-ink/60">
          Give the leader one link. Every signed waiver is filed under this team.
        </p>{
          created && (
            <p class="mt-4 border border-green-900/20 bg-green-900/5 p-3 text-sm">
              Team link created.
            </p>
          )
        }{
          exists && (
            <p class="mt-4 border border-red-900/20 bg-red-900/5 p-3 text-sm">
              That team number already exists.
            </p>
          )
        }{
          badTeam && (
            <p class="mt-4 border border-red-900/20 bg-red-900/5 p-3 text-sm">
              Complete the team details.
            </p>
          )
        }<form action="/api/admin/teams" method="post" class="mt-5 grid gap-4">
          <label class="text-sm font-medium"
            >Team number<input
              required
              name="teamNumber"
              type="number"
              min="1"
              inputmode="numeric"
              class="mt-1 w-full border border-ink/20 px-3 py-2.5"
            /></label
          ><label class="text-sm font-medium"
            >Team leader name<input
              required
              name="leaderName"
              class="mt-1 w-full border border-ink/20 px-3 py-2.5"
            /></label
          ><label class="text-sm font-medium"
            >Trip type<select
              required
              name="waiverType"
              class="mt-1 w-full border border-ink/20 bg-white px-3 py-2.5"
              ><option value="fishing-adventure">Fishing adventure</option><option value="lodge"
                >Wilson River Lodge</option
              ></select
            ></label
          ><label class="text-sm font-medium"
            >Trip date <span class="font-normal text-ink/50">optional</span><input
              name="tripDate"
              type="date"
              class="mt-1 w-full border border-ink/20 px-3 py-2.5"
            /></label
          ><button class="btn btn-solid-dark mt-1 w-full" type="submit">Create share link</button>
        </form>
      </aside>
    </div>
  </section>
</AdminLayout>
<script is:inline define:vars={{ initialCount: waivers.length }}>
  document.querySelectorAll('[data-copy]').forEach((button) =>
    button.addEventListener('click', async () => {
      await navigator.clipboard.writeText(button.dataset.copy);
      const text = button.textContent;
      button.textContent = 'Copied';
      setTimeout(() => (button.textContent = text), 1600);
    }),
  );

  // Native share sheet. Revealed only where the browser actually has one, so it is never
  // a button that does nothing.
  if (navigator.share) {
    document.querySelectorAll('[data-share]').forEach((button) => {
      button.hidden = false;
      button.addEventListener('click', async () => {
        try {
          await navigator.share({
            title: button.dataset.shareTitle,
            text: "Please sign your waiver before the trip with Big Dave's Fishing.",
            url: button.dataset.share,
          });
        } catch {
          /* dismissing the sheet rejects — not an error worth reporting */
        }
      });
    });
  }

  // Guests sign on their phones while this page sits open on the counter, so it polls
  // for the total and reloads when it moves. Reloading rather than patching the DOM: the
  // page is server-rendered and grouping a new signature under the right team by hand
  // would duplicate that logic in the browser, for a page one person has open.
  (function pollForNewWaivers() {
    const status = document.querySelector('[data-live-status]');
    let known = initialCount;
    let failures = 0;

    const tick = async () => {
      try {
        const res = await fetch('/api/admin/waiver-count', { cache: 'no-store' });
        // 401 means the 12-hour session lapsed. Stop rather than hammering the endpoint
        // for a page that can no longer read it.
        if (res.status === 401) {
          if (status) status.textContent = 'Signed out — refresh to sign back in';
          return;
        }
        if (!res.ok) throw new Error(String(res.status));
        failures = 0;

        const { count } = await res.json();
        if (count !== known) {
          known = count;
          if (status) status.textContent = 'New waiver signed — updating…';
          location.reload();
          return;
        }
      } catch {
        // Offline or the dev server restarted. Back off instead of retrying every 15s.
        failures += 1;
        if (failures >= 4) {
          if (status) status.textContent = 'Not updating — check your connection';
          return;
        }
      }
      setTimeout(tick, failures ? 15000 * failures : 15000);
    };

    setTimeout(tick, 15000);
  })();
</script>
