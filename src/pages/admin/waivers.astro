---
export const prerender = false;
import AdminLayout from '../../layouts/AdminLayout.astro';
import {
  db,
  ensureSchema,
  parseMinorNames,
  WAIVER_LIST_COLUMNS,
  type WaiverListRow,
  type WaiverTeam,
  type AdminAction,
} from '../../lib/db';

import { mailConfig } from '../../lib/email';
import { getAdminSignaturePng } from '../../lib/admin-signature';
// Pinned to the shop's locale and timezone. A bare toLocaleString() here renders in the
// SERVER's settings, not the reader's, because this page is server-rendered.
import { formatSignedAt, formatTripDate } from '../../lib/dates';

await ensureSchema();

// Deleting is master-only (see api/admin/delete.ts). Staff get the same dashboard minus
// the delete controls, rather than buttons that only ever answer 403.
const isMaster = Astro.locals.admin?.role === 'master';

// Archiving is how a finished trip leaves the list, so the default view is everything
// still live. The archived view is the same page with the filter flipped, nothing is
// ever deleted, and anything here can be put straight back.
const view = Astro.url.searchParams.get('view') === 'archived' ? 'archived' : 'active';
const archivedFilter = view === 'archived' ? 'archived_at IS NOT NULL' : 'archived_at IS NULL';

/**
 * How many waivers one view renders at once.
 *
 * There was no limit. Every waiver in the table was selected and rendered, each with its
 * own lazily-loaded signature request - fine at the three rows this has today, and a
 * page that takes progressively longer to open every week of a season. 200 is well past
 * any real trip and keeps the query bounded.
 *
 * Nothing becomes unreachable: archiving is how a finished party leaves the active list,
 * and the archived view holds everything that has left it. The notice below says so
 * rather than letting rows quietly fall off the end.
 */
const WAIVER_PAGE_LIMIT = 200;

// Explicit columns, never SELECT *: signature_png is a base64 blob and pulling 60 of them
// into this page made it 1 MB. Each signature is fetched separately, lazily, below.
// The queries are independent, so they run together rather than one after the other.
const [waiverResult, teamResult, tallyResult, actionsResult, groupTotalsResult] = await Promise.all(
  [
    db.execute(
      `SELECT ${WAIVER_LIST_COLUMNS} FROM waivers WHERE ${archivedFilter}
       ORDER BY signed_at DESC LIMIT ${WAIVER_PAGE_LIMIT}`,
    ),
    db.execute('SELECT * FROM waiver_teams ORDER BY team_number ASC'),
    db.execute(
      `SELECT
       COUNT(*) AS total,
       SUM(CASE WHEN archived_at IS NOT NULL THEN 1 ELSE 0 END) AS archived,
       SUM(CASE WHEN archived_at IS NULL AND emailed_at IS NULL THEN 1 ELSE 0 END) AS queued
     FROM waivers`,
    ),
    db.execute('SELECT * FROM admin_actions ORDER BY created_at DESC LIMIT 15'),
    // Deliberately NOT filtered by the current view. Everything else on this page shows
    // one view at a time, but deleting a team takes its waivers with it whether they are
    // archived or not, so the warning has to count all of them. Counting the visible ones
    // told an operator who had just archived a finished trip that nobody had signed it,
    // and then deleted the lot.
    db.execute(
      `SELECT group_code,
         COUNT(*) AS total,
         SUM(CASE WHEN archived_at IS NOT NULL THEN 1 ELSE 0 END) AS archived
       FROM waivers
       WHERE group_code IS NOT NULL
       GROUP BY group_code`,
    ),
  ],
);

const recentActions = actionsResult.rows as unknown as AdminAction[];

/**
 * Which admins on this page have a signature at all - not the image itself.
 *
 * All this decides is whether a row shows the signature or the logo-and-name stand-in.
 * The image is then fetched by the browser from /api/admin/admin-signature?key=…, one
 * lookup per distinct admin here and one HTTP request per distinct admin there, cached
 * and shared by every row that names the same person.
 *
 * It used to hold the base64 data URL and write it into the markup once per row, which
 * on a nine-entry page was 106 kB of a 216 kB document - the same mistake that had
 * already been fixed for guest signatures, repeated here where the duplication is worse.
 */
// Looked up together rather than one after another. This was an `await` inside a `for`,
// so N distinct admins meant N sequential round trips to the database before the page
// could start rendering - each one waiting on the last for no reason, since none of them
// depends on any other.
const distinctAdminKeys = [...new Set(recentActions.map((a) => a.admin_key))];
const signaturePresence = await Promise.all(
  distinctAdminKeys.map(async (key) => [key, Boolean(await getAdminSignaturePng(key))] as const),
);
const adminsWithSignature = new Set(
  signaturePresence.filter(([, present]) => present).map(([key]) => key),
);

const ACTION_LABEL: Record<string, string> = {
  'waiver.archive': 'Archived',
  'waiver.restore': 'Restored',
  'waiver.delete': 'Deleted',
  'team.create': 'Created',
  'team.delete': 'Deleted',
  'staff.create': 'Added staff',
  'staff.remove': 'Removed staff',
  'digest.send': 'Emailed roster',
};

const tally = tallyResult.rows[0] as unknown as {
  total: number | null;
  archived: number | null;
  queued: number | null;
};
const archivedCount = Number(tally?.archived ?? 0);
const queuedCount = Number(tally?.queued ?? 0);

/**
 * Every waiver in the table, archived or not.
 *
 * This is the number the live poller is seeded with, and it has to be counted the same
 * way /api/admin/waiver-count counts it - which is unfiltered. It used to be seeded with
 * `waivers.length`, the CURRENT VIEW's row count, so the moment a single waiver was
 * archived the two disagreed permanently: the poller saw a changed count on its first
 * tick, reloaded, was re-seeded with the same filtered number, and reloaded again every
 * 15 seconds for as long as the dashboard was open. Archiving one finished trip made the
 * page unusable.
 */
const totalCount = Number(tally?.total ?? 0);
const mail = mailConfig();
const mailReady = 'config' in mail;

const waivers = waiverResult.rows as unknown as WaiverListRow[];
const teams = teamResult.rows as unknown as WaiverTeam[];
const teamCodes = new Set(teams.map((team) => team.group_code));

/**
 * How many waivers a team really has, and how many of those are archived, across both
 * views. `signedByGroup` below only ever holds the current view's rows, so it cannot
 * answer "what would deleting this team destroy?" - see the query comment above.
 */
const totalsByGroup = new Map<string, { total: number; archived: number }>();
for (const row of groupTotalsResult.rows) {
  totalsByGroup.set(String(row.group_code), {
    total: Number(row.total ?? 0),
    archived: Number(row.archived ?? 0),
  });
}
const signedByGroup = new Map<string, WaiverListRow[]>();
for (const waiver of waivers) {
  // Grouped under a team only if that team still exists. A waiver carrying a group_code
  // with no matching team row, an old link, or a team removed since, used to key off
  // the orphan code, which meant it rendered in no card at all: invisible on the
  // dashboard, and now that Archive exists, impossible to clear. It falls through to the
  // signed-ahead list instead, where it is at least visible and actionable.
  const key =
    waiver.group_code && teamCodes.has(waiver.group_code)
      ? waiver.group_code
      : `manual:${waiver.group_leader_name || 'ungrouped'}`;
  if (!signedByGroup.has(key)) signedByGroup.set(key, []);
  signedByGroup.get(key)!.push(waiver);
}
const manualGroups = [...signedByGroup.entries()].filter(([key]) => key.startsWith('manual:'));

// In the archived view a team with nothing archived under it is just noise. On the active
// list every team stays visible, because an empty one is exactly the team whose link
// still needs sending.
const visibleTeams =
  view === 'archived'
    ? teams.filter((team) => (signedByGroup.get(team.group_code) || []).length > 0)
    : teams;

const appUrl = Astro.url.origin;
const params = Astro.url.searchParams;
const created = params.get('team-created') === '1';
const exists = params.get('team-exists');
const badTeam = params.get('team-error');

// Which field was wrong, in words. "Complete the team details" told nobody anything.
const FIELD_PROBLEM: Record<string, string> = {
  teamNumber: 'Team number must be digits only, no letters or symbols.',
  leaderName: "Enter the team leader's name: letters only, at least 2 characters.",
  waiverType: 'Choose a trip type.',
  tripDate: 'That trip date was not accepted.',
};

// Values typed on a failed attempt, so the form comes back filled in rather than blank.
const prev = {
  teamNumber: params.get('prev_teamNumber') ?? '',
  leaderName: params.get('prev_leaderName') ?? '',
  waiverType: params.get('prev_waiverType') ?? 'fishing-adventure',
  tripDate: params.get('prev_tripDate') ?? '',
};

// The next unused number. Reusing one is the single most common way creating a link
// fails, and there is no reason to make anyone remember which are taken.
//
// Deliberately independent of what was typed. One value used to serve two jobs - prefill
// the box, and suggest a free number - and on the one screen where the suggestion matters,
// a duplicate-number error, it had just been overwritten with the number that failed. The
// advice read "Team 1 already exists. Use 1".
const nextFreeTeamNumber = String(
  teams.reduce((highest, t) => Math.max(highest, t.team_number), 0) + 1,
);

// What the box shows: whatever was typed on a failed attempt, so nothing is entered
// twice, otherwise the free number as a starting point.
const teamNumberValue = prev.teamNumber || nextFreeTeamNumber;

const teamDeleted = params.get('team-deleted') === '1';
const deletedWith = Number(params.get('with') ?? 0);
const deletedWaivers = Number(params.get('deleted') ?? 0);
const deleteFailed = params.get('delete-error') === '1';
const archivedJustNow = Number(params.get('archived') ?? 0);
const restoredJustNow = Number(params.get('restored') ?? 0);
const digestStatus = params.get('digest');
const digestGuests = params.get('guests');
const digestMissing = params.get('missing');
const digestReason = params.get('reason');
---

<AdminLayout title="Waiver dashboard">
  <section class="mx-auto max-w-6xl px-5 py-8 md:px-8 md:py-12">
    <header class="flex flex-wrap items-start justify-between gap-5 border-b border-ink/15 pb-7">
      <div>
        <img src="/art/logo-badge-ink-160.webp" alt="Big Dave's Fishing" class="h-14 w-14" /><p
          class="eyebrow mt-4 text-ink/65"
        >
          Staff dashboard
        </p><h1 class="mt-1 text-3xl md:text-5xl">Waiver teams</h1><p
          class="mt-2 text-sm text-ink/60"
        >
          {waivers.length}{view === 'archived' ? ' archived' : ' signed'} waiver{
            waivers.length === 1 ? '' : 's'
          } across {teams.length} team{teams.length === 1 ? '' : 's'}.
        </p>

        <!-- Active / Archived. A link rather than a filter control, so the view is in the
             URL and Dave can leave the archived list open on a tab without it resetting. -->
        <div class="mt-3 flex gap-2 text-xs">
          <a
            href="/admin/waivers"
            class={`border px-3 py-1.5 ${view === 'active' ? 'border-ink bg-ink text-cream' : 'border-ink/25'}`}
            >Active</a
          >
          <a
            href="/admin/waivers?view=archived"
            class={`border px-3 py-1.5 ${view === 'archived' ? 'border-ink bg-ink text-cream' : 'border-ink/25'}`}
            >Archived ({archivedCount})</a
          >
        </div>

        <!-- Tells Dave the page is watching, so he doesn't sit there refreshing it while
             a group signs. The script rewrites this text when something changes. -->
        <p class="mt-2 flex items-center gap-2 text-xs text-ink/50">
          <span class="inline-block h-1.5 w-1.5 rounded-full bg-green-700" aria-hidden="true"
          ></span>
          {
            /* The starting count rides on a data attribute rather than through
               `define:vars`. define:vars forces the script to be `is:inline`, which means
               Astro neither compiles nor hashes it - and an unhashed inline script is
               refused outright under the Content-Security-Policy this site now sends. As
               a data attribute the value is just markup, and the script below is an
               ordinary compiled module covered by 'self'. */
          }
          <span data-live-status data-initial-count={String(totalCount)}
            >Watching for new waivers</span
          >
        </p>
      </div>
      <div class="flex flex-col items-end gap-2">
        <a href="/admin/signature" class="border border-ink/25 px-4 py-2 text-sm">
          Your signature
        </a>
        {
          /* Only the master account can create or remove staff logins - shown only to
            master, and enforced again server-side in /admin/staff itself, since a link
            being absent from the UI is not a security boundary on its own. */
          Astro.locals.admin?.role === 'master' && (
            <a href="/admin/staff" class="border border-ink/25 px-4 py-2 text-sm">
              Manage staff
            </a>
          )
        }
        <form action="/api/admin/logout" method="post">
          <button class="border border-ink/25 px-4 py-2 text-sm">Sign out</button>
        </form>

        {
          /* The roster goes out on a schedule; this is the same send on demand, for
            testing the keys, and for the group that signs an hour before they launch and
            needs to be in Dave's phone before he loses signal at the ramp. Disabled
            rather than hidden when unconfigured, so the reason is visible. */
        }
        <form action="/api/admin/send-digest" method="post">
          <button
            class="border border-ink bg-ink px-4 py-2 text-sm text-cream disabled:cursor-not-allowed disabled:opacity-40"
            disabled={!mailReady || queuedCount === 0}
            title={!mailReady
              ? 'Email is not set up yet'
              : queuedCount === 0
                ? 'Everyone signed so far has already been emailed'
                : undefined}
          >
            Email roster now{queuedCount > 0 ? ` (${queuedCount})` : ''}
          </button>
        </form>
      </div>
    </header>

    {
      /* One row of feedback for the actions that leave and come back: archiving,
         restoring, and sending. Read off the query string the redirect set. */
    }
    {
      /* Said out loud rather than letting the oldest rows drop off the end unannounced.
         Only appears once the view is actually full. */
      waivers.length >= WAIVER_PAGE_LIMIT && (
        <p class="mt-5 border border-ink/20 bg-white p-3 text-sm">
          Showing the {WAIVER_PAGE_LIMIT} most recent{view === 'archived' ? ' archived' : ''}{' '}
          waivers.{' '}
          {view === 'archived'
            ? 'Older ones are still in the database and are not deleted.'
            : 'Archive the parties you have finished with to clear this list.'}
        </p>
      )
    }
    {
      archivedJustNow > 0 && (
        <p class="mt-5 border border-ink/20 bg-white p-3 text-sm">
          Archived {archivedJustNow} waiver{archivedJustNow === 1 ? '' : 's'}. Nothing was deleted.
          They are under{' '}
          <a class="underline" href="/admin/waivers?view=archived">
            Archived
          </a>
          .
        </p>
      )
    }
    {
      teamDeleted && (
        <p class="mt-5 border border-ink/20 bg-white p-3 text-sm">
          Team deleted
          {deletedWith > 0
            ? `, along with ${deletedWith} signed waiver${deletedWith === 1 ? '' : 's'}`
            : ', and no one had signed it'}
          .
        </p>
      )
    }
    {
      deletedWaivers > 0 && (
        <p class="mt-5 border border-ink/20 bg-white p-3 text-sm">
          Deleted {deletedWaivers} waiver{deletedWaivers === 1 ? '' : 's'}.
        </p>
      )
    }
    {
      deleteFailed && (
        <p class="mt-5 border border-red-900/20 bg-red-900/5 p-3 text-sm">
          Nothing was deleted. That record no longer exists.
        </p>
      )
    }
    {
      restoredJustNow > 0 && (
        <p class="mt-5 border border-ink/20 bg-white p-3 text-sm">
          Restored {restoredJustNow} waiver{restoredJustNow === 1 ? '' : 's'} to the active list.
        </p>
      )
    }
    {
      digestStatus === 'sent' && (
        <p class="mt-5 border border-green-900/20 bg-green-900/5 p-3 text-sm">
          Roster emailed to cover {digestGuests} guest{digestGuests === '1' ? '' : 's'}. Check the
          inbox; if it isn't there, look in spam and see docs/waiver-email-setup.md about SPF and
          DKIM.
        </p>
      )
    }
    {
      digestStatus === 'empty' && (
        <p class="mt-5 border border-ink/20 bg-white p-3 text-sm">
          Nothing to send. Everyone who has signed has already been emailed.
        </p>
      )
    }
    {
      digestStatus === 'unconfigured' && (
        <p class="mt-5 border border-red-900/20 bg-red-900/5 p-3 text-sm">
          Email isn't set up yet. Missing: {digestMissing}.
        </p>
      )
    }
    {
      digestStatus === 'failed' && (
        <p class="mt-5 border border-red-900/20 bg-red-900/5 p-3 text-sm">
          The roster did not send, so it stays queued and will go out on the next attempt.{' '}
          {digestReason}
        </p>
      )
    }
    {
      /* Said plainly rather than left to be discovered: the schedule is off until the
         keys exist, and the dashboard is unaffected either way. */
      !mailReady && (
        <p class="mt-5 border border-ink/20 bg-white p-3 text-sm text-ink/70">
          Waiver emails are not set up yet. The dashboard works as normal, nothing is being sent.
          Add the mail keys from <code>.env.example</code> to switch it on.
        </p>
      )
    }

    <div class="mt-8 grid gap-8 lg:grid-cols-[minmax(0,1fr)_22rem]">
      <div class="order-2 lg:order-1">
        <h2 class="text-2xl">{view === 'archived' ? 'Archived teams' : 'Teams & signed guests'}</h2>
        {
          visibleTeams.length === 0 && manualGroups.length === 0 && (
            <p class="mt-5 text-sm text-ink/60">
              {view === 'archived'
                ? 'Nothing archived yet. Archiving a team here clears it off the active list without deleting anything.'
                : 'Create the first team link on the right.'}
            </p>
          )
        }
        <div class="mt-5 space-y-6">
          {
            visibleTeams.map((team) => {
              const members = signedByGroup.get(team.group_code) || [];
              const link = `${appUrl}/waivers/${team.waiver_type}?g=${team.group_code}`;
              // What Delete team would actually destroy: every waiver under this code,
              // not just the ones this view happens to be showing.
              const totals = totalsByGroup.get(team.group_code) ?? { total: 0, archived: 0 };
              const signedWord = `signed waiver${totals.total === 1 ? '' : 's'}`;
              // Called out separately because these are the ones not on screen, and
              // therefore the ones an operator does not expect to lose.
              const archivedNote = totals.archived > 0 ? ` (${totals.archived} archived)` : '';
              return (
                <article class="border border-ink/15 bg-white">
                  <>
                    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-ink/15 bg-ink px-5 py-4 text-cream">
                      <>
                        <div>
                          <>
                            <p class="eyebrow text-cream/65">Team {team.team_number}</p>
                            <h3 class="mt-1 text-xl">{team.leader_name}</h3>
                          </>
                        </div>
                        <p class="text-sm text-cream/75">
                          {members.length} signed
                          {team.trip_date ? ` · ${formatTripDate(team.trip_date)}` : ''}
                        </p>
                      </>
                    </div>
                    <div class="p-5">
                      <div class="mt-2 flex gap-2">
                        <>
                          {/* Named, because a bare readonly box reads as "edit text,
                              blank" to a screen reader. The team number is in the name so
                              a page of these is distinguishable one from another. */}
                          <input
                            readonly
                            value={link}
                            aria-label={`Signing link for team ${team.team_number} (${team.leader_name})`}
                            class="min-w-0 flex-1 border border-ink/20 bg-cream px-3 py-2 text-xs"
                          />
                          <button
                            type="button"
                            class="border border-ink px-3 text-xs"
                            data-copy={link}
                          >
                            Copy
                          </button>
                        </>
                      </div>

                      {/* Copy alone means leaving the page, opening Messages and pasting.
                          These hand the link straight to the app it gets sent from.
                          The Share button uses the native share sheet where one exists
                          (any phone, Safari, Edge) and stays hidden where it doesn't. */}
                      <div class="mt-2 flex flex-wrap gap-2 text-xs">
                        <button
                          type="button"
                          hidden
                          class="border border-ink/30 px-3 py-1.5"
                          data-share={link}
                          data-share-title={`${team.waiver_type === 'lodge' ? 'Lodge' : 'Fishing'} waiver for team ${team.team_number}`}
                        >
                          Share…
                        </button>
                        <a
                          class="border border-ink/30 px-3 py-1.5"
                          href={`sms:?&body=${encodeURIComponent(`Big Dave's Fishing: please sign your waiver before the trip: ${link}`)}`}
                        >
                          Text
                        </a>
                        <a
                          class="border border-ink/30 px-3 py-1.5"
                          href={`mailto:?subject=${encodeURIComponent("Waiver for your trip with Big Dave's Fishing")}&body=${encodeURIComponent(`Please sign your waiver before the trip:\n\n${link}\n\nIt only takes a minute: name, phone, emergency contact and a signature.\n\nBig Dave's Fishing Adventures`)}`}
                        >
                          Email
                        </a>
                        <a
                          class="border border-ink/30 px-3 py-1.5"
                          href={link}
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          Open
                        </a>
                      </div>
                      {members.length === 0 ? (
                        <p class="mt-5 text-sm text-ink/55">No signed guests yet.</p>
                      ) : (
                        <ul class="mt-5 divide-y divide-ink/10">
                          {members.map((member) => (
                            <li class="flex flex-wrap items-center gap-4 py-3">
                              {/* Fetched per-signature and lazily: only the ones actually
                                  scrolled into view are ever requested, and each is
                                  cached immutably after that. width/height are set so
                                  the row does not reflow as they arrive.

                                  Wrapped in a link because at thumbnail size you can tell
                                  that someone signed but not what they wrote, and this is
                                  a legal record: opening the PNG full size is what makes
                                  it readable, savable and printable. Same admin-only
                                  endpoint the thumbnail already uses, so it adds no new
                                  exposure. */}
                              <a
                                href={`/api/admin/signature/${member.id}`}
                                target="_blank"
                                rel="noopener noreferrer"
                                title={`View ${member.guest_name}'s signature full size`}
                                class="shrink-0"
                              >
                                <img
                                  src={`/api/admin/signature/${member.id}`}
                                  alt={`Signature of ${member.guest_name}. Opens full size.`}
                                  width="96"
                                  height="36"
                                  loading="lazy"
                                  decoding="async"
                                  class="h-9 w-24 border border-ink/15 bg-cream object-contain hover:border-ink/50"
                                />
                              </a>
                              <div class="min-w-40 flex-1">
                                <p class="font-medium">{member.guest_name}</p>
                                <p class="text-xs text-ink/60">
                                  {member.guest_phone}
                                  {member.guest_email ? ` · ${member.guest_email}` : ''}
                                </p>
                                {/* The number Dave actually needs in a bad moment. It was
                                    only ever in the digest email, which is no help to
                                    whoever is looking at this screen. */}
                                <p class="text-xs text-red-900/70">
                                  Emergency: {member.emergency_contact_name} ·{' '}
                                  <a
                                    href={`tel:${member.emergency_contact_phone}`}
                                    class="underline"
                                  >
                                    {member.emergency_contact_phone}
                                  </a>
                                </p>
                                {parseMinorNames(member.minor_names).length > 0 && (
                                  <p class="text-xs text-ink/70">
                                    Under 18: {parseMinorNames(member.minor_names).join(', ')}
                                  </p>
                                )}
                              </div>
                              <p class="text-xs text-ink/55">
                                Signed {formatSignedAt(member.signed_at)}
                              </p>
                              {/* For a row that should never have existed, a test entry,
                                  a double submission. Permanent, so it confirms first and
                                  stays visually quiet next to Archive, which is the one
                                  staff should reach for nearly always. */}
                              {isMaster && (
                                <form action="/api/admin/delete" method="post">
                                  <input type="hidden" name="target" value="waivers" />
                                  <input type="hidden" name="ids" value={member.id} />
                                  <button
                                    class="inline-flex min-h-11 items-center px-1 text-xs text-red-900/70 underline"
                                    data-confirm={`Permanently delete the waiver signed by ${member.guest_name}? This cannot be undone.`}
                                  >
                                    Delete
                                  </button>
                                </form>
                              )}
                            </li>
                          ))}
                        </ul>
                      )}

                      {/* Clearing a finished trip off the list. A human presses this,
                          nothing archives on a timer, because only staff know a trip is
                          actually done. It is also independent of the email: if the mail
                          provider is having a bad day, this still works. */}
                      {members.length > 0 && (
                        <form
                          action="/api/admin/archive"
                          method="post"
                          class="mt-5 border-t border-ink/10 pt-4"
                        >
                          <input
                            type="hidden"
                            name="ids"
                            value={members.map((m) => m.id).join(',')}
                          />
                          <input
                            type="hidden"
                            name="action"
                            value={view === 'archived' ? 'restore' : 'archive'}
                          />
                          <button class="border border-ink/30 px-3 py-1.5 text-xs">
                            {view === 'archived'
                              ? 'Restore to active list'
                              : `Archive team (${members.length})`}
                          </button>
                          <span class="ml-3 text-xs text-ink/50">
                            {view === 'archived'
                              ? 'Puts this team back on the active list.'
                              : 'Hides it from this list. Nothing is deleted.'}
                          </span>
                        </form>
                      )}

                      {/* A link made with the wrong number, a duplicate, a test, things
                          that should never have existed. Separate from Archive because
                          this is permanent, and the confirm says exactly how many signed
                          waivers go with it - counted across both views, because archived
                          ones are deleted too and are the ones not on screen to notice. */}
                      {isMaster && (
                        <form
                          action="/api/admin/delete"
                          method="post"
                          class={members.length > 0 ? 'mt-3' : 'mt-5 border-t border-ink/10 pt-4'}
                        >
                          <input type="hidden" name="target" value="team" />
                          <input type="hidden" name="teamId" value={team.id} />
                          <button
                            class="inline-flex min-h-11 items-center px-1 text-xs text-red-900/70 underline"
                            data-confirm={
                              totals.total > 0
                                ? `Permanently delete team ${team.team_number} (${team.leader_name}) AND its ${totals.total} ${signedWord}${archivedNote}? This cannot be undone.`
                                : `Permanently delete team ${team.team_number} (${team.leader_name})? No one has signed it. This cannot be undone.`
                            }
                          >
                            Delete team
                          </button>
                          <span class="ml-3 text-xs text-ink/50">
                            {totals.total > 0
                              ? `Removes the team and its ${totals.total} ${signedWord}${archivedNote}. Permanent.`
                              : 'Removes this empty team link. Permanent.'}
                          </span>
                        </form>
                      )}
                    </div>
                  </>
                </article>
              );
            })
          }
          {
            /* Guests who signed from the public waiver page before any team link existed.
               This used to render as a comma-separated list of names and nothing else,
               which was survivable while every waiver arrived through a team link. Now
               that anyone can sign ahead from the website, these are real bookings-in-
               waiting and need the same detail as a team: who to ring, and the signature
               that was actually captured. */
            manualGroups.map(([key, members]) => (
              <article class="border border-ink/15 bg-white">
                <div class="flex flex-wrap items-center justify-between gap-3 border-b border-ink/15 bg-ink px-5 py-4 text-cream">
                  <div>
                    <p class="eyebrow text-cream/65">Signed ahead · no team link yet</p>
                    <h3 class="mt-1 text-xl">{key.replace('manual:', '')}</h3>
                  </div>
                  <p class="text-sm text-cream/75">
                    {members.length} signed
                    {members[0]?.trip_date ? ` · ${formatTripDate(members[0].trip_date)}` : ''}
                  </p>
                </div>

                <ul class="divide-y divide-ink/10 p-5 pt-0">
                  {members.map((member) => (
                    <li class="flex flex-wrap items-center gap-4 py-3">
                      {/* Same link-to-full-size as on a team card, for the same reason. */}
                      <a
                        href={`/api/admin/signature/${member.id}`}
                        target="_blank"
                        rel="noopener noreferrer"
                        title={`View ${member.guest_name}'s signature full size`}
                        class="shrink-0"
                      >
                        <img
                          src={`/api/admin/signature/${member.id}`}
                          alt={`Signature of ${member.guest_name}. Opens full size.`}
                          width="96"
                          height="36"
                          loading="lazy"
                          decoding="async"
                          class="h-9 w-24 border border-ink/15 bg-cream object-contain hover:border-ink/50"
                        />
                      </a>
                      <div class="min-w-40 flex-1">
                        <p class="font-medium">{member.guest_name}</p>
                        <p class="text-xs text-ink/60">
                          {member.guest_phone}
                          {member.guest_email ? ` · ${member.guest_email}` : ''}
                        </p>
                        <p class="text-xs text-red-900/70">
                          Emergency: {member.emergency_contact_name} ·{' '}
                          <a href={`tel:${member.emergency_contact_phone}`} class="underline">
                            {member.emergency_contact_phone}
                          </a>
                        </p>
                        {parseMinorNames(member.minor_names).length > 0 && (
                          <p class="text-xs text-ink/70">
                            Under 18: {parseMinorNames(member.minor_names).join(', ')}
                          </p>
                        )}
                      </div>
                      <p class="text-xs text-ink/55">Signed {formatSignedAt(member.signed_at)}</p>
                      {/* Same permanent delete as on a team card. These sign-ahead rows
                          are where a mistaken or duplicate entry is most likely to land,
                          since anyone can submit one from the public page. */}
                      {isMaster && (
                        <form action="/api/admin/delete" method="post">
                          <input type="hidden" name="target" value="waivers" />
                          <input type="hidden" name="ids" value={member.id} />
                          <button
                            class="inline-flex min-h-11 items-center px-1 text-xs text-red-900/70 underline"
                            data-confirm={`Permanently delete the waiver signed by ${member.guest_name}? This cannot be undone.`}
                          >
                            Delete
                          </button>
                        </form>
                      )}
                    </li>
                  ))}
                </ul>

                <form
                  action="/api/admin/archive"
                  method="post"
                  class="border-t border-ink/10 px-5 py-4"
                >
                  <input type="hidden" name="ids" value={members.map((m) => m.id).join(',')} />
                  <input
                    type="hidden"
                    name="action"
                    value={view === 'archived' ? 'restore' : 'archive'}
                  />
                  <button class="border border-ink/30 px-3 py-1.5 text-xs">
                    {view === 'archived'
                      ? 'Restore to active list'
                      : `Archive these (${members.length})`}
                  </button>
                  <span class="ml-3 text-xs text-ink/50">
                    {view === 'archived'
                      ? 'Puts them back on the active list.'
                      : 'Hides them from this list. Nothing is deleted.'}
                  </span>
                </form>
              </article>
            ))
          }
        </div>
      </div>
      <aside class="order-1 border border-ink/15 bg-white p-5 lg:order-2 lg:self-start">
        <p class="eyebrow text-ink/60">New trip</p><h2 class="mt-2 text-2xl">
          Create a team link
        </h2><p class="mt-2 text-sm text-ink/60">
          Give the leader one link. Every signed waiver is filed under this team.
        </p>{
          created && (
            <p class="mt-4 border border-green-900/20 bg-green-900/5 p-3 text-sm">
              Team link created.
            </p>
          )
        }{
          exists && (
            <p class="mt-4 border border-red-900/20 bg-red-900/5 p-3 text-sm">
              Team {exists} already exists. Use {nextFreeTeamNumber}, or delete the old one first.
              Your details are still filled in below.
            </p>
          )
        }{
          badTeam && (
            <p class="mt-4 border border-red-900/20 bg-red-900/5 p-3 text-sm">
              {FIELD_PROBLEM[badTeam] ?? 'Check the team details.'}
            </p>
          )
        }<form action="/api/admin/teams" method="post" class="mt-5 grid gap-4" data-team-form>
          <label class="text-sm font-medium"
            >Team number<input
              required
              name="teamNumber"
              type="text"
              inputmode="numeric"
              pattern="[0-9]+"
              maxlength="6"
              autocomplete="off"
              data-digits
              value={teamNumberValue}
              class="mt-1 w-full border border-ink/20 px-3 py-2.5"
            /></label
          ><label class="text-sm font-medium"
            >Team leader name<input
              required
              name="leaderName"
              minlength="2"
              maxlength="200"
              autocomplete="off"
              data-letters
              value={prev.leaderName}
              class="mt-1 w-full border border-ink/20 px-3 py-2.5"
            /></label
          ><label class="text-sm font-medium"
            >Trip type<select
              required
              name="waiverType"
              class="mt-1 w-full border border-ink/20 bg-white px-3 py-2.5"
              ><option value="fishing-adventure" selected={prev.waiverType !== 'lodge'}
                >Fishing adventure</option
              ><option value="lodge" selected={prev.waiverType === 'lodge'}
                >Wilson River Lodge</option
              ></select
            ></label
          ><label class="text-sm font-medium"
            >Trip date <span class="font-normal text-ink/50">optional</span><input
              name="tripDate"
              type="date"
              value={prev.tripDate}
              class="mt-1 w-full border border-ink/20 px-3 py-2.5"
            /></label
          ><button class="btn btn-solid-dark mt-1 w-full" type="submit">Create share link</button>
        </form>
      </aside>
    </div>

    {
      /* Who did what, stamped automatically from each admin's own session - nobody
        types their name or confirms a signature to make this appear. Capped at the
        last 15 rather than paginated: this is a quick "who touched what" glance, not
        a compliance log someone audits back through months of history. */
    }
    <div class="mt-12 border-t border-ink/15 pt-8">
      <h2 class="text-2xl">Recent activity</h2>
      {
        recentActions.length === 0 ? (
          <p class="mt-4 text-sm text-ink/60">Nothing logged yet.</p>
        ) : (
          <ul class="mt-5 divide-y divide-ink/10 border border-ink/15 bg-white">
            {recentActions.map((entry) => {
              const hasSignature = adminsWithSignature.has(entry.admin_key);
              return (
                <li class="flex flex-wrap items-center gap-4 p-4">
                  {hasSignature ? (
                    <img
                      src={`/api/admin/admin-signature?key=${encodeURIComponent(entry.admin_key)}`}
                      alt={`${entry.admin_name}'s signature`}
                      width="80"
                      height="36"
                      loading="lazy"
                      decoding="async"
                      class="h-9 w-20 border border-ink/15 bg-cream object-contain"
                    />
                  ) : (
                    // No signature drawn yet: the company badge next to the admin's own
                    // name, so this still reads as "who", not just "the company did it" -
                    // each admin's version differs by name, the one thing a shared logo
                    // alone wouldn't tell you.
                    <span class="flex h-9 items-center gap-1.5 border border-ink/10 bg-cream px-2">
                      <img src="/email-logo.png" alt="" class="h-6 w-6 shrink-0 object-contain" />
                      <span class="font-display truncate text-sm text-ink/70 italic">
                        {entry.admin_name}
                      </span>
                    </span>
                  )}
                  <div class="min-w-0 flex-1">
                    <p class="text-sm">
                      <span class="font-medium">{entry.admin_name}</span>{' '}
                      {(ACTION_LABEL[entry.action] ?? entry.action).toLowerCase()}
                      {entry.target && <> &middot; {entry.target}</>}
                    </p>
                    <p class="text-xs text-ink/50">{formatSignedAt(entry.created_at)}</p>
                  </div>
                </li>
              );
            })}
          </ul>
        )
      }
    </div>
  </section>
</AdminLayout>
<script>
  // The create-team form.
  //
  // Two problems it had, both of which lost whatever had been typed. The auto-refresh
  // below reloads the page when someone signs, which wiped a half-filled form without
  // warning; and any failed submission came back blank. So: every keystroke is kept in
  // sessionStorage and restored on load, and the refresh holds off while the form has
  // unsaved input.
  const teamForm = document.querySelector<HTMLFormElement>('[data-team-form]');
  const FORM_KEY = 'bigdave.teamForm';
  const FIELDS = ['teamNumber', 'leaderName', 'waiverType', 'tripDate'];

  /**
   * Whether the create-team form holds unsaved input the auto-refresh must not destroy.
   *
   * A module-scoped function rather than `window.__teamFormDirty`. The two halves that
   * need it - the form setup and the poller - are in this one script, so the global was
   * only ever a way of passing a value across a few lines, and it put an untyped property
   * on `window` that nothing declared. Defaults to "not dirty" so a page without the form
   * still refreshes normally.
   */
  let teamFormDirty = () => false;

  /** A named control on the team form, or null if the markup no longer carries it. */
  const fieldNamed = (form: HTMLFormElement, name: string) =>
    form.elements.namedItem(name) as HTMLInputElement | HTMLSelectElement | null;

  // Typed straight into the field: a team number is written on a whiteboard, not
  // calculated, and a leader's name never contains digits or symbols. Stripping as you
  // type beats rejecting after submitting.
  const clean = (input: HTMLInputElement) => {
    if (input.dataset.digits !== undefined) return input.value.replace(/[^0-9]/g, '').slice(0, 6);
    if (input.dataset.letters !== undefined)
      return input.value.replace(/[^\p{L}\s'.-]/gu, '').slice(0, 200);
    return input.value;
  };

  if (teamForm) {
    const numberField = fieldNamed(teamForm, 'teamNumber');
    const suggested = numberField ? numberField.value : '';

    // A successful create clears the draft; anything else restores it.
    if (new URLSearchParams(location.search).get('team-created') === '1') {
      sessionStorage.removeItem(FORM_KEY);
    } else {
      try {
        const saved = JSON.parse(sessionStorage.getItem(FORM_KEY) || 'null') as Record<
          string,
          string
        > | null;
        if (saved) {
          for (const name of FIELDS) {
            const field = fieldNamed(teamForm, name);
            if (field && saved[name]) field.value = saved[name];
          }
        }
      } catch {
        /* a corrupt draft is not worth failing the page over */
      }
    }

    teamForm.addEventListener('input', (event) => {
      const target = event.target;
      if (target instanceof HTMLInputElement) {
        const cleaned = clean(target);
        if (cleaned !== target.value) target.value = cleaned;
      }
      const draft: Record<string, string> = {};
      for (const name of FIELDS) {
        const field = fieldNamed(teamForm, name);
        if (field) draft[name] = field.value;
      }
      sessionStorage.setItem(FORM_KEY, JSON.stringify(draft));
    });

    teamForm.addEventListener('submit', () => sessionStorage.removeItem(FORM_KEY));

    // "Dirty" means there is something worth protecting: a name or date typed, or a team
    // number changed from the one we suggested.
    const leaderField = fieldNamed(teamForm, 'leaderName');
    const dateField = fieldNamed(teamForm, 'tripDate');
    teamFormDirty = () =>
      Boolean(
        leaderField?.value.trim() ||
        dateField?.value ||
        (numberField && numberField.value !== suggested),
      );
  }

  // Deletion is permanent, so every button carrying data-confirm has to be agreed to
  // first. Attached to submit rather than click so keyboard submission is covered too.
  document.querySelectorAll<HTMLElement>('[data-confirm]').forEach((button) => {
    const form = button.closest('form');
    if (form)
      form.addEventListener('submit', (event) => {
        if (!window.confirm(button.dataset.confirm)) event.preventDefault();
      });
  });

  // The Clipboard API is unavailable outside a secure context and can be refused by
  // permission policy, and it rejects rather than throwing synchronously. Unguarded, a
  // dashboard opened over plain http on the shop LAN had a Copy button that did nothing
  // at all: no copy, no error, no "Copied", just an unhandled rejection in a console
  // nobody has open. Falling back to selecting the field means the link can always be
  // copied by hand, and the button says which of the two just happened.
  document.querySelectorAll<HTMLElement>('[data-copy]').forEach((button) => {
    const label = button.textContent;
    const flash = (message: string) => {
      button.textContent = message;
      setTimeout(() => (button.textContent = label), 1600);
    };

    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? '');
        flash('Copied');
      } catch {
        // Put the link in front of them, selected, so Ctrl+C finishes the job.
        const input = button.closest('div')?.querySelector<HTMLInputElement>('input[readonly]');
        if (input) {
          input.focus();
          input.select();
          flash('Press Ctrl+C');
        } else {
          flash('Copy failed');
        }
      }
    });
  });

  // Native share sheet. Revealed only where the browser actually has one, so it is never
  // a button that does nothing.
  if (navigator.share) {
    document.querySelectorAll<HTMLElement>('[data-share]').forEach((button) => {
      button.hidden = false;
      button.addEventListener('click', async () => {
        try {
          await navigator.share({
            title: button.dataset.shareTitle,
            text: "Please sign your waiver before the trip with Big Dave's Fishing.",
            url: button.dataset.share,
          });
        } catch {
          /* dismissing the sheet rejects, not an error worth reporting */
        }
      });
    });
  }

  // Guests sign on their phones while this page sits open on the counter, so it polls
  // for the total and reloads when it moves. Reloading rather than patching the DOM: the
  // page is server-rendered and grouping a new signature under the right team by hand
  // would duplicate that logic in the browser, for a page one person has open.
  (function pollForNewWaivers() {
    const status = document.querySelector<HTMLElement>('[data-live-status]');

    /**
     * The count this page was rendered with, read off the element rather than injected
     * into the script.
     *
     * It must be counted the SAME WAY /api/admin/waiver-count counts it - every row in
     * the table, archived or not. It used to be the current view's row count, so opening
     * the dashboard with anything archived meant the two could never agree: the first
     * tick saw a difference, reloaded, was re-seeded with the same filtered number, and
     * reloaded again every 15 seconds for as long as the page was open.
     */
    let known = Number(status?.dataset.initialCount ?? 0);
    let failures = 0;

    const tick = async () => {
      try {
        const res = await fetch('/api/admin/waiver-count', { cache: 'no-store' });
        // 401 means the 12-hour session lapsed. Stop rather than hammering the endpoint
        // for a page that can no longer read it.
        if (res.status === 401) {
          if (status) status.textContent = 'Signed out. Refresh to sign back in';
          return;
        }
        if (!res.ok) throw new Error(String(res.status));
        failures = 0;

        const { count } = await res.json();
        if (count !== known) {
          // Never reload out from under someone mid-sentence. The whole point of this
          // poller is convenience, and destroying a half-written team link to deliver it
          // is a bad trade. It waits, says so, and reloads once the form is clear.
          if (teamFormDirty()) {
            if (status) status.textContent = 'New waiver signed. Refreshing once you’re done';
          } else {
            known = count;
            if (status) status.textContent = 'New waiver signed. Updating…';
            location.reload();
            return;
          }
        }
      } catch {
        // Offline or the dev server restarted. Back off instead of retrying every 15s.
        failures += 1;
        if (failures >= 4) {
          if (status) status.textContent = 'Not updating. Check your connection';
          return;
        }
      }
      setTimeout(tick, failures ? 15000 * failures : 15000);
    };

    setTimeout(tick, 15000);
  })();
</script>
