---
export const prerender = false;
import AdminLayout from '../../layouts/AdminLayout.astro';

// Any signed-in admin, master or staff alike, can reach this page - same reasoning as
// /admin/signature. What it does once here differs by identity, checked below.
const identity = Astro.locals.admin!;

const errorCode = Astro.url.searchParams.get('error');
const FIELD_PROBLEM: Record<string, string> = {
  'current-password': 'That is not your current password.',
  password: 'Use a new password of at least 8 characters.',
  confirm: 'Those passwords do not match.',
  locked: 'Too many incorrect attempts. Try again in a few minutes.',
};
const problem = errorCode ? (FIELD_PROBLEM[errorCode] ?? 'Check the details and try again.') : null;
const success = Astro.url.searchParams.get('success') === '1';
---

<AdminLayout title="Change password">
  <section class="mx-auto max-w-md px-5 py-8 md:px-8 md:py-12">
    <a href="/admin/waivers" class="text-sm underline underline-offset-2">&larr; Back to waivers</a>
    <p class="eyebrow text-ink/65 mt-5">Your account</p>
    <h1 class="mt-1 text-3xl md:text-5xl">Change password</h1>

    {
      identity.role === 'master' ? (
        <p class="mt-6 border border-ink/20 bg-white p-4 text-sm text-ink/70">
          The master login's password is set in the site's deployment settings (
          <code>ADMIN_PASSWORD</code>), not stored here, so there is nothing on this page that can
          change it. To change it, update that setting where the site is hosted - doing so signs
          every admin and staff session out at once, master and staff alike.
        </p>
      ) : (
        <>
          <p class="mt-2 text-sm text-ink/60">
            Changes the password you sign in with at the staff login page. Nobody else is affected.
          </p>

          {success && (
            <p class="mt-6 border border-green-900/20 bg-green-900/5 p-3 text-sm">
              Password changed. Use it next time you sign in.
            </p>
          )}
          {problem && (
            <p class="mt-6 border border-red-900/20 bg-red-900/5 p-3 text-sm">{problem}</p>
          )}

          <form action="/api/admin/change-password" method="post" class="mt-6 grid gap-4">
            <label class="text-sm font-medium">
              Current password
              <input
                required
                type="password"
                name="currentPassword"
                autocomplete="current-password"
                class="mt-1 w-full border border-ink/20 px-3 py-2.5"
              />
            </label>
            <label class="text-sm font-medium">
              New password
              <input
                required
                type="password"
                name="newPassword"
                minlength="8"
                autocomplete="new-password"
                class="mt-1 w-full border border-ink/20 px-3 py-2.5"
              />
            </label>
            <label class="text-sm font-medium">
              Confirm new password
              <input
                required
                type="password"
                name="confirmPassword"
                minlength="8"
                autocomplete="new-password"
                class="mt-1 w-full border border-ink/20 px-3 py-2.5"
              />
            </label>
            <button class="btn btn-solid-dark mt-1 w-full" type="submit">
              Change password
            </button>
          </form>
        </>
      )
    }
  </section>
</AdminLayout>
