---
import { getImage } from 'astro:assets';
import '../styles/global.css';
import BrandRail from '../components/BrandRail.astro';
import Footer from '../components/Footer.astro';
import BookBar from '../components/BookBar.astro';
import CardNav from '../components/ui/CardNav.astro';
import { business, nav, navCards, waiverLinks } from '../lib/business';
import { isIndexable, siteOrigin } from '../lib/site-url';
import { scriptHash } from '../lib/csp-hash';
import { REVEAL_BOOTSTRAP } from '../lib/inline-scripts.mjs';
import badge from '../assets/photos/logo-badge.png';
import wood from '../assets/photos/wood-texture.png';
// The share card's photo. Picked for resolution as much as subject: at 1500x1000 it is
// the only photo on the site large enough to fill a 1200x630 card without being upscaled,
// and every other candidate is 800x600 or 1200x900. Swap it when the hi-res originals
// land, see the note at the top of src/lib/photos.ts.
import shareImage from '../assets/photos/wilson-river-lodge-oregon-river-fishing.webp';

// Both resolved here rather than inside the island: Astro owns the hashed asset URLs,
// and this way no image imports ship to the client.
/**
 * The badge in the mobile header bar.
 *
 * It draws at 51-58 CSS px, and a single 120px copy was all that existed - fine at 1x,
 * soft on the 2x and 3x screens nearly every phone has, and softer still the moment
 * anyone zooms in. The candidates below let the browser take the one that matches its
 * own pixel density: `sizes` is quoted a little above the real drawn width deliberately,
 * so a 2x phone takes the 240 rather than scraping by on the 120.
 */
const badgeImg = await getImage({
  src: badge,
  width: 240,
  widths: [120, 240, 360],
  sizes: '72px',
  format: 'webp',
});

// 1200x630 is what Facebook, LinkedIn and X all crop to. Generated once here rather than
// per page, because every page shares the same card image.
const shareImg = await getImage({ src: shareImage, width: 1200, height: 630, format: 'jpg' });

interface Props {
  title: string;
  description: string;
  /**
   * Keeps a page out of search results. For the account screens: a login form or a
   * password reset is not something anyone searches for, and each one indexed is a thin
   * page competing with the real ones for the business's own name.
   */
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;

/**
 * The canonical URL for this page.
 *
 * Built from PUBLIC_SITE_URL where it is set, so the canonical always names the real
 * domain, a canonical pointing at a preview deployment tells Google the preview is the
 * original. Query strings are dropped deliberately: `?g=turner-0814` on a waiver page is
 * one link Dave sent a group, not a separate page to index.
 */
const origin = siteOrigin(Astro.url);
// Trailing slashes are stripped so /contact and /contact/ never claim to be two pages.
// The root is the one exception, its canonical is the origin plus "/", not a bare origin.
const path = Astro.url.pathname.replace(/\/+$/, '');
const canonical = path ? `${origin}${path}` : `${origin}/`;
const shareImageUrl = new URL(shareImg.src, origin).href;

/**
 * Structured data for the business.
 *
 * Only facts that are confirmed. `geo` and `openingHoursSpecification` used to be here
 * with invented coordinates and made-up 06:00–18:00 hours, schema that contradicts the
 * page is worse than schema that is absent, and inventing opening hours for a guide who
 * fishes by the tide is a claim nobody checked. They go back in when the client confirms
 * them; see docs/handover.md.
 *
 * `sameAs` is likewise omitted until the real Facebook URL is supplied, pointing it at
 * facebook.com's home page asserted that the business's profile is Facebook itself.
 */
/**
 * The two scripts on this page that have to be inline, and their CSP hashes.
 *
 * Both are rendered with `set:html` from these exact strings, and both hashes are
 * registered below, so the Content-Security-Policy Astro emits admits them and nothing
 * else. See src/lib/csp-hash.ts for why these are computed rather than configured.
 *
 * `is:inline` is not a style choice for either one. The JSON-LD has to be a real
 * `<script type="application/ld+json">` in the document for search engines to read it -
 * there is no external-file form they honour. The reveal bootstrap has to run before
 * first paint; bundled, it would become a deferred module and every section would paint
 * visible, then hide, then animate, which is worse than having no animation at all.
 */
const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${origin}/#business`,
  name: business.name,
  url: `${origin}/`,
  telephone: business.phone,
  email: business.email,
  image: shareImageUrl,
  address: {
    '@type': 'PostalAddress',
    streetAddress: business.address.street,
    addressLocality: business.address.locality,
    addressRegion: business.address.region,
    postalCode: business.address.postalCode,
    addressCountry: business.address.country,
  },
  areaServed: business.serviceArea,
  ...(business.facebook ? { sameAs: [business.facebook] } : {}),
};

const schemaJson = JSON.stringify(localBusinessSchema);

/**
 * Structured data is emitted on prerendered pages only, and that is a CSP constraint
 * rather than an SEO choice.
 *
 * The JSON-LD carries the share image's build-hashed URL, so its own hash is not
 * knowable until the build has run - it cannot be declared in astro.config.mjs the way
 * the reveal bootstrap is. It has to be registered at render time, and a render-time
 * hash only reaches prerendered pages: Astro streams SSR responses and sends the CSP
 * header before the body renders. On a server-rendered route the block would simply be
 * refused by the browser, which is a console error and no structured data either way.
 *
 * Nothing of value is lost. Every page local search actually reads - the homepage,
 * contact, the lodge, rates, fishing information, videos - is prerendered and keeps it.
 * The routes that miss out are login, signup, account and the waiver signing pages,
 * none of which have any business claiming to be the business's LocalBusiness record.
 */
const canEmitSchema = Astro.isPrerendered;

// Optional-chained because `Astro.csp` only exists when security.csp is enabled, and it
// is not applied at all in `astro dev`. Registering a hash is then simply a no-op rather
// than a crash on every page of the dev server.
if (canEmitSchema) Astro.csp?.insertScriptHash(await scriptHash(schemaJson));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Generated from the brand badge by scripts/make-favicon.mjs. The .ico carries
         16/32/48 for the tab strip and for browsers that probe /favicon.ico directly;
         the 96px PNG is what high-DPI tabs and bookmark lists pick up. -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon-96.png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Preview and branch deployments must never be indexed: a staging copy in the
         index competes with the real site for its own name. isIndexable() is true only
         on the production deployment. -->
    {(noindex || !isIndexable()) && <meta name="robots" content="noindex, nofollow" />}

    <!-- Social cards. og:image is an absolute URL on the canonical origin, because
         Facebook and X fetch it from their own servers and a relative path resolves to
         nothing there. -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content={`${business.name}: guided salmon fishing on Oregon's coastal rivers`}
    />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImageUrl} />

    <meta name="theme-color" content="#1c1a17" />

    <!-- Both are rendered from the exact strings their hashes were taken over, via
         set:html, rather than typed out again here: retyping either one would change its
         text and break its own hash. -->
    {canEmitSchema && <script type="application/ld+json" set:html={schemaJson} is:inline />}

    <script is:inline set:html={REVEAL_BOOTSTRAP} />
  </head>

  <body class="bg-cream text-ink">
    <span id="top"></span>

    <!-- Skip link. Every page puts nine rail links, a waiver disclosure and the floating
         nav ahead of the content in tab order, so reaching the page itself by keyboard
         meant tabbing through the entire site menu first, on every page.

         Hidden until focused rather than visually-hidden-always: the first Tab press on
         a page reveals it, which is the one moment it is useful. -->
    <a
      href="#main"
      class="bg-ink text-cream sr-only rounded-sm px-4 py-3 text-sm font-medium focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[60]"
    >
      Skip to content
    </a>

    <!-- One chrome, two shapes. The fixed rail is the nav at xl+; below that it hides
         and the floating CardNav takes over. Each hides itself at the other's widths,
         so they are never both on screen.

         CardNav floats over the page rather than pushing it down, which is why the
         homepage hero starts flush at the top. Inner pages already carry pt-28/md:pt-36
         below xl, which clears it. -->
    <BrandRail />

    <div style={`--bd-board: url(${wood.src});`}>
      <CardNav
        logo={badgeImg.src}
        logoSrcset={badgeImg.srcSet.attribute}
        logoSizes="72px"
        logoAlt=""
        items={navCards}
        baseColor="#f4f4f4"
        menuColor="#111111"
        buttonBgColor="#111111"
        buttonTextColor="#f4f4f4"
        ctaLabel="Book Now"
        ctaHref="/contact"
      />

      <!-- The nav's panel is opened by a script, so without JS there is no menu below xl.
           This is the whole site in plain markup for that case; it costs nothing and
           renders only when scripting is off. -->
      <noscript>
        <nav aria-label="Primary" class="bg-ink text-cream xl:hidden">
          <ul class="flex flex-wrap justify-center gap-x-5 gap-y-2 px-4 py-3 text-sm">
            {
              [...nav, ...waiverLinks].map((link) => (
                <li>
                  <a href={link.href} class="underline underline-offset-2">
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </noscript>
    </div>

    <div class="rail-offset flex min-h-screen flex-col">
      <!-- tabindex="-1" so the skip link can actually move focus here; without it the
           browser scrolls to <main> but focus stays on the link, and the next Tab
           continues from the nav again. -->
      <main id="main" tabindex="-1" class="flex-1 outline-none"><slot /></main>
      <Footer />
    </div>
    <BookBar />

    <script>
      // --- Word-splitting for headings marked [data-reveal-text] ------------------
      // Each word becomes .rt-mask > .rt-word so it can rise out from behind its own
      // baseline, staggered in reading order.
      //
      // Only ever splits plain text nodes, and leaves any nested markup (a <span>, a
      // <br>) untouched, so a heading with an accent span keeps working. The rendered
      // text is identical, so selection, search-in-page and screen readers see no
      // change; assistive tech reads the element's text content, not its span tree.
      const splitWords = () => {
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduce) return;

        for (const el of document.querySelectorAll<HTMLElement>('[data-reveal-text]')) {
          if (el.dataset.rtDone) continue;
          el.dataset.rtDone = '1';

          let index = 0;
          // Snapshot first: replacing nodes while iterating childNodes skips entries.
          for (const node of [...el.childNodes]) {
            if (node.nodeType !== Node.TEXT_NODE) continue;
            const text = node.textContent ?? '';
            if (!text.trim()) continue;

            const frag = document.createDocumentFragment();
            // Keep the separators so original spacing survives verbatim.
            for (const part of text.split(/(\s+)/)) {
              if (!part) continue;
              if (/^\s+$/.test(part)) {
                frag.append(part);
                continue;
              }
              const mask = document.createElement('span');
              mask.className = 'rt-mask';
              const word = document.createElement('span');
              word.className = 'rt-word';
              // Capped so a long heading's last word doesn't arrive a second late.
              word.style.setProperty('--rt-delay', `${Math.min(index * 55, 500)}ms`);
              word.textContent = part;
              mask.append(word);
              frag.append(mask);
              index += 1;
            }
            node.replaceWith(frag);
          }
        }
      };

      splitWords();

      // Reveal each [data-reveal] block once it comes into view, then stop watching it.
      // rootMargin pulls the trigger line up from the bottom edge so a section has
      // finished animating by the time it is properly on screen.
      const targets = document.querySelectorAll<HTMLElement>('[data-reveal], [data-reveal-text]');
      const revealAll = () => targets.forEach((el) => el.classList.add('is-in'));

      if (!('IntersectionObserver' in window)) {
        revealAll();
      } else {
        // The failure mode here is the worst one available - a section that never
        // animates in is a section nobody can read - so the effect is treated as
        // strictly optional. IntersectionObserver delivers an initial callback for
        // every target shortly after observe(), whether or not it is on screen, so
        // if nothing has arrived at all within a beat, observation is not running
        // (a hidden or non-compositing tab will do this) and everything is simply
        // shown. Once a single callback lands, the effect is known to work and the
        // safety net is dropped.
        let delivered = false;

        const observer = new IntersectionObserver(
          (entries) => {
            delivered = true;
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-in');
              observer.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -12% 0px', threshold: 0.05 },
        );

        targets.forEach((el) => observer.observe(el));

        window.setTimeout(() => {
          if (delivered) return;
          observer.disconnect();
          revealAll();
        }, 1500);
      }
    </script>
  </body>
</html>
