---
import { getImage } from 'astro:assets';
import '../styles/global.css';
import BrandRail from '../components/BrandRail.astro';
import Footer from '../components/Footer.astro';
import BookBar from '../components/BookBar.astro';
import CardNav from '../components/ui/CardNav.tsx';
import { business, nav, navCards, waiverLinks } from '../lib/business';
import badge from '../assets/photos/logo-badge.png';
import wood from '../assets/photos/wood-texture.png';

// Both resolved here rather than inside the island: Astro owns the hashed asset URLs,
// and this way no image imports ship to the client.
const badgeImg = await getImage({ src: badge, width: 120, format: 'webp' });

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: business.name,
  telephone: business.phone,
  email: business.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: business.address.street,
    addressLocality: business.address.locality,
    addressRegion: business.address.region,
    postalCode: business.address.postalCode,
    addressCountry: business.address.country,
  },
  areaServed: business.serviceArea,
  // TODO: replace with real geo coordinates and confirmed hours
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
    opens: '06:00',
    closes: '18:00',
  },
  sameAs: [business.facebook],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Generated from the brand badge by scripts/make-favicon.mjs. The .ico carries
         16/32/48 for the tab strip and for browsers that probe /favicon.ico directly;
         the 96px PNG is what high-DPI tabs and bookmark lists pick up. -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon-96.png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />

    <!-- Arms the reveal animation before first paint, so sections start hidden rather
         than flashing in once the observer attaches. Deliberately the only thing that
         sets this class: if the script is blocked, the CSS hidden state never applies
         and the page is simply visible. -->
    <script is:inline>
      document.documentElement.classList.add('js-reveal');
    </script>
  </head>

  <body class="bg-cream text-ink">
    <span id="top"></span>

    <!-- One chrome, two shapes. The fixed rail is the nav at xl+; below that it hides
         and the floating CardNav takes over. Each hides itself at the other's widths,
         so they are never both on screen.

         CardNav floats over the page rather than pushing it down, which is why the
         homepage hero starts flush at the top. Inner pages already carry pt-28/md:pt-36
         below xl, which clears it. -->
    <BrandRail />

    <div style={`--bd-board: url(${wood.src});`}>
      <CardNav
        client:load
        logo={badgeImg.src}
        logoAlt=""
        items={navCards}
        baseColor="#f4f4f4"
        menuColor="#111111"
        buttonBgColor="#111111"
        buttonTextColor="#f4f4f4"
        ctaLabel="Book Now"
        ctaHref="/contact"
      />

      <!-- The nav is a React island, so without JS there is no menu at all below xl.
           This is the whole site in plain markup for that case; it costs nothing and
           renders only when scripting is off. -->
      <noscript>
        <nav aria-label="Primary" class="bg-ink text-cream xl:hidden">
          <ul class="flex flex-wrap justify-center gap-x-5 gap-y-2 px-4 py-3 text-sm">
            {
              [...nav, ...waiverLinks].map((link) => (
                <li>
                  <a href={link.href} class="underline underline-offset-2">
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </noscript>
    </div>

    <div class="rail-offset flex min-h-screen flex-col">
      <main class="flex-1"><slot /></main>
      <Footer />
    </div>
    <BookBar />

    <script>
      // --- Word-splitting for headings marked [data-reveal-text] ------------------
      // Each word becomes .rt-mask > .rt-word so it can rise out from behind its own
      // baseline, staggered in reading order.
      //
      // Only ever splits plain text nodes, and leaves any nested markup (a <span>, a
      // <br>) untouched — so a heading with an accent span keeps working. The rendered
      // text is identical, so selection, search-in-page and screen readers see no
      // change; assistive tech reads the element's text content, not its span tree.
      const splitWords = () => {
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduce) return;

        for (const el of document.querySelectorAll<HTMLElement>('[data-reveal-text]')) {
          if (el.dataset.rtDone) continue;
          el.dataset.rtDone = '1';

          let index = 0;
          // Snapshot first: replacing nodes while iterating childNodes skips entries.
          for (const node of [...el.childNodes]) {
            if (node.nodeType !== Node.TEXT_NODE) continue;
            const text = node.textContent ?? '';
            if (!text.trim()) continue;

            const frag = document.createDocumentFragment();
            // Keep the separators so original spacing survives verbatim.
            for (const part of text.split(/(\s+)/)) {
              if (!part) continue;
              if (/^\s+$/.test(part)) {
                frag.append(part);
                continue;
              }
              const mask = document.createElement('span');
              mask.className = 'rt-mask';
              const word = document.createElement('span');
              word.className = 'rt-word';
              // Capped so a long heading's last word doesn't arrive a second late.
              word.style.setProperty('--rt-delay', `${Math.min(index * 55, 500)}ms`);
              word.textContent = part;
              mask.append(word);
              frag.append(mask);
              index += 1;
            }
            node.replaceWith(frag);
          }
        }
      };

      splitWords();

      // Reveal each [data-reveal] block once it comes into view, then stop watching it.
      // rootMargin pulls the trigger line up from the bottom edge so a section has
      // finished animating by the time it is properly on screen.
      const targets = document.querySelectorAll<HTMLElement>('[data-reveal], [data-reveal-text]');
      const revealAll = () => targets.forEach((el) => el.classList.add('is-in'));

      if (!('IntersectionObserver' in window)) {
        revealAll();
      } else {
        // The failure mode here is the worst one available - a section that never
        // animates in is a section nobody can read - so the effect is treated as
        // strictly optional. IntersectionObserver delivers an initial callback for
        // every target shortly after observe(), whether or not it is on screen, so
        // if nothing has arrived at all within a beat, observation is not running
        // (a hidden or non-compositing tab will do this) and everything is simply
        // shown. Once a single callback lands, the effect is known to work and the
        // safety net is dropped.
        let delivered = false;

        const observer = new IntersectionObserver(
          (entries) => {
            delivered = true;
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-in');
              observer.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -12% 0px', threshold: 0.05 },
        );

        targets.forEach((el) => observer.observe(el));

        window.setTimeout(() => {
          if (delivered) return;
          observer.disconnect();
          revealAll();
        }, 1500);
      }
    </script>
  </body>
</html>
