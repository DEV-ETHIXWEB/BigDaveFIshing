---
import '../styles/global.css';
import Header from '../components/Header.astro';
import HeaderDesktop from '../components/HeaderDesktop.astro';
import Footer from '../components/Footer.astro';
import FooterDesktop from '../components/FooterDesktop.astro';
import MobileMenu from '../components/MobileMenu.astro';
import BottomTabBar from '../components/BottomTabBar.astro';
import { business } from '../lib/business';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: business.name,
  telephone: business.phone,
  areaServed: business.serviceArea,
  // TODO: replace with real street address, geo coordinates, and hours once confirmed
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
    opens: '06:00',
    closes: '18:00',
  },
  sameAs: [business.facebook],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
  </head>
  <!-- No bg utility here: the body sits outside the grayscale regions, so its
       background comes from the already-desaturated value in global.css. -->
  <body class="text-ink">
    <span id="top"></span>
    <!-- Two chromes, one per breakpoint. Below xl: the mockup's transparent overlay
         header plus the slide-in menu and bottom tab bar. At xl+: the original dark
         sticky bar. Each is hidden at the other's widths, so only one is ever visible;
         the page body does the same in index.astro. -->
    <HeaderDesktop />
    <main class="relative">
      <Header />
      <slot />
    </main>
    <Footer />
    <FooterDesktop />
    <MobileMenu />
    <BottomTabBar />
  </body>
</html>
