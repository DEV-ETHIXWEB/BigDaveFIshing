---
import '../styles/global.css';
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head
    ><meta charset="utf-8" /><meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    /><!-- The staff area had none of this: no icon, so an admin tab was a blank page
           marker among the site's own tabs, and no robots directive of its own. The
           middleware already sends X-Robots-Tag on every /admin response; this is the
           belt-and-braces copy that travels with the document itself. -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" /><link
      rel="icon"
      type="image/png"
      href="/favicon-96.png"
      sizes="96x96"
    /><meta name="robots" content="noindex, nofollow" /><meta
      name="description"
      content="Staff area for Big Dave's Fishing Adventures."
    /><title>{title} | Big Dave's Fishing</title></head
  >
  <body class="min-h-screen bg-cream text-ink"
    ><main><slot /></main><footer
      class="border-ink/15 border-t px-6 py-5 text-center text-xs text-ink/55"
    >
      Big Dave&rsquo;s Fishing Adventures &middot; Staff area
    </footer></body
  >
</html>
