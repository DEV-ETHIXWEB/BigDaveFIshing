# Waiver storage. Leave both unset and everything works against a local file at
# ./data/waivers.db, no account needed, useful for dev and demos. For a real
# deployment, create a free database at https://turso.tech and paste its values here
# (and in your host's environment variable settings, Vercel/Netlify project settings,
# not this file, which is never deployed).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Gates /admin/waivers. Required, the admin area refuses to load without both set.
ADMIN_USER=
ADMIN_PASSWORD=

# Signs the admin session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, the cookie is signed with ADMIN_PASSWORD, which means a weak password is
# also a weak signing key, and an attacker can forge a session without touching the
# login form. Set this in production. Changing it signs everyone out.
ADMIN_SESSION_SECRET=

# ---------------------------------------------------------------------------
# Outbound email. Full setup notes: docs/waiver-email-setup.md
#
# Two things send mail, and they share these settings, one provider, one verified
# sender, one inbox to check:
#
#   1. The daily waiver digest (scheduled, plus the dashboard's "Email roster now").
#   2. The homepage booking form, which posts to /api/booking.
#
# THIS IS REQUIRED FOR LAUNCH. Leave it blank and the waiver digest simply refuses
# instead of failing silently, but the booking form has nowhere to deliver a lead, so
# it answers 503 and tells the visitor to phone instead. That is the honest behaviour,
# not an acceptable one: an unconfigured deployment cannot take enquiries.
# ---------------------------------------------------------------------------

# Set ONE of these. If more than one is set the first in this order wins.
#   SMTP2GO:  https://smtp2go.com      (X-Smtp2go-Api-Key), the only one of the three that
#                                       will send from a single verified address with no
#                                       domain and no DNS. Use this until the real domain
#                                       is available.
#   Resend:   https://resend.com       (key starts re_), refuses to send anywhere except
#                                       your own signup address until a domain is verified.
#   Postmark: https://postmarkapp.com  (Server API token)
SMTP2GO_API_KEY=
RESEND_API_KEY=
POSTMARK_SERVER_TOKEN=

# Who the digest is FROM. Must be a sender the provider has verified, or the send is
# rejected outright.
#
# Without a domain of your own (SMTP2GO): add the address under
# Sending > Verified Senders > Single sender emails, click the link it sends you, and use
# that exact address here. Works in two minutes, no DNS.
#
# With the domain (do this before Dave relies on it): verify bigdavesfishing.com and
# publish the SPF and DKIM records, then use an address on it. A single verified sender
# does not align SPF/DKIM with the From domain, so more of these land in spam, and a
# digest in spam is worse than no digest, because nobody notices it stopped.
#   e.g. "Big Dave's Fishing <waivers@bigdavesfishing.com>"
WAIVER_DIGEST_FROM=

# Who receives the roster AND the booking enquiries. Comma-separated for more than one.
# This is the inbox Dave actually checks, if a lead lands somewhere nobody reads, the
# form is broken in the way that matters.
#   e.g. bigdave@bigdavesfishing.com,leslie@bigdavesfishing.com
WAIVER_DIGEST_TO=

# Authorises the scheduled run at /api/cron/waiver-digest. Vercel sends this
# automatically as a bearer token once the variable exists on the project. Without it the
# scheduled digest is disabled (the manual dashboard button still works). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Public origin of the live site. No trailing slash.
#
# Required in production, and it does more than the digest link. Every canonical URL,
# every og:image, and sitemap.xml are built from it. Without it they fall back to
# whatever hostname the request arrived on, which on Vercel can be the deployment's
# internal *.vercel.app address, telling Google to index that instead of the real domain.
#   e.g. https://bigdavesfishing.com
PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# Set automatically by the host, do not add these yourself.
#
# VERCEL_ENV decides whether a deployment may be indexed. It is "production" only on the
# production deployment, so previews serve `Disallow: /` and a noindex tag and cannot
# compete with the live site in search. On a host that does not set it, indexing is
# enabled only when PUBLIC_SITE_URL is set and NODE_ENV is production.
# ---------------------------------------------------------------------------
